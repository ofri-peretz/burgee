{
  "$comment": "The default branch of serverless takes changes only through a pull request that passes its gates: no force-push, no deletion, linear history, and these checks, each of which reported success on every one of the repo's last 15 merged PRs (so none can sit unreported and stall a merge). No approving review is required, because Claude merges its own PRs once green. Repository admins bypass (RELEASE_BOT_PAT acts as one). GitHub Actions cannot be a bypass actor on a personal account's repos (the API answers 422); no workflow here pushes to main with GITHUB_TOKEN, they all open PRs. Applied by .github/workflows/rulesets.yml.",
  "owner": "ofri-peretz",
  "repos": [
    "serverless"
  ],
  "ruleset": {
    "name": "Protect main",
    "target": "branch",
    "enforcement": "active",
    "conditions": {
      "ref_name": {
        "include": [
          "~DEFAULT_BRANCH"
        ],
        "exclude": []
      }
    },
    "bypass_actors": [
      {
        "actor_id": 5,
        "actor_type": "RepositoryRole",
        "bypass_mode": "always"
      }
    ],
    "rules": [
      {
        "type": "deletion"
      },
      {
        "type": "non_fast_forward"
      },
      {
        "type": "required_linear_history"
      },
      {
        "type": "pull_request",
        "parameters": {
          "required_approving_review_count": 0,
          "dismiss_stale_reviews_on_push": false,
          "require_code_owner_review": false,
          "require_last_push_approval": false,
          "required_review_thread_resolution": true,
          "allowed_merge_methods": [
            "squash",
            "rebase"
          ]
        }
      },
      {
        "type": "required_status_checks",
        "parameters": {
          "strict_required_status_checks_policy": false,
          "do_not_enforce_on_create": true,
          "required_status_checks": [
            {
              "context": "CI",
              "integration_id": 15368
            },
            {
              "context": "Fast Gate (oxlint + format)",
              "integration_id": 15368
            },
            {
              "context": "ESLint (deep pass)",
              "integration_id": 15368
            },
            {
              "context": "Validate PR Title",
              "integration_id": 15368
            },
            {
              "context": "hookset / hookset check",
              "integration_id": 15368
            }
          ]
        }
      }
    ]
  }
}
