{
  "$comment": "The default branch of impact-ingest takes changes only through a pull request: no force-push, no deletion, linear history, and every review thread resolved. No required status checks yet: its CI job names are not yet proven on 15 merged PRs. No workflow here pushes to main (verified 2026-11-26: the last commits are all PR squashes). Repository admins bypass. Applied by .github/workflows/rulesets.yml.",
  "owner": "ofri-peretz",
  "repos": [
    "impact-ingest"
  ],
  "ruleset": {
    "name": "Protect main",
    "target": "branch",
    "enforcement": "active",
    "conditions": {
      "ref_name": {
        "include": [
          "~DEFAULT_BRANCH"
        ],
        "exclude": []
      }
    },
    "bypass_actors": [
      {
        "actor_id": 5,
        "actor_type": "RepositoryRole",
        "bypass_mode": "always"
      }
    ],
    "rules": [
      {
        "type": "deletion"
      },
      {
        "type": "non_fast_forward"
      },
      {
        "type": "required_linear_history"
      },
      {
        "type": "pull_request",
        "parameters": {
          "required_approving_review_count": 0,
          "dismiss_stale_reviews_on_push": false,
          "require_code_owner_review": false,
          "require_last_push_approval": false,
          "required_review_thread_resolution": true,
          "allowed_merge_methods": [
            "squash",
            "rebase"
          ]
        }
      }
    ]
  }
}
