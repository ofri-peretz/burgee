    "body": "```ts\nimport { setTimeout } from 'timers/promises';\nimport { createLogUpdate } from 'log-update';\n\nconst update = createLogUpdate(process.stdout, { showCursor: true });\n\nupdate('# Hello world\\n\\n');\n\nawait setTimeout(50);\n\nupdate('# Hello world\\n\\nIt\\'s');\n\nawait setTimeout(50);\n\nupdate('# Hello world\\n\\nIt\\'s a beautiful day');\n```\n\nExpected to be:\n\n```\n> tsx test.ts\n# Hello world\n\nIt's a beautiful day\n>\n```\n\nActual:\n\n```\n> tsx test.ts\n# Hello world\nIt's a beautiful day\n>\n```\n",
