{
  "name": "benchmarks",
  "version": "0.0.0",
  "private": true,
  "description": "One suite, four axes (agent cost, cold start, compatibility, weight). Emits one JSON document per run under results/, which the Stage 6 control bands read. Internal; never published.",
  "type": "module",
  "exports": {
    "./published.js": "./published.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bench": "tsx run.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "burgee": "*",
    "caique": "*",
    "compat-oracle": "*",
    "flagstaff": "*",
    "roundel": "*"
  },
  "devDependencies": {
    "boxen": "^8.0.1",
    "cac": "^7.0.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "esbuild": "^0.28.0",
    "log-update": "8.0.0",
    "ora": "9.4.1",
    "picocolors": "^1.1.1",
    "vitest": "^5.0.0",
    "yargs": "^18.0.0"
  }
}
