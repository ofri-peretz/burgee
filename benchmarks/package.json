{
  "name": "benchmarks",
  "version": "0.0.2",
  "private": true,
  "description": "One suite, four axes (agent cost, cold start, compatibility, weight). Emits one JSON document per run under results/, which the Stage 6 control bands read. Internal; never published.",
  "type": "module",
  "exports": {
    "./axes/weight.js": "./axes/weight.ts",
    "./claims.js": "./claims.ts",
    "./fixtures/entry-points.js": "./fixtures/entry-points.ts",
    "./published.js": "./published.ts",
    "./resolve.js": "./resolve.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bench": "tsx run.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "bellpull": "^0.3.0",
    "burgee": "*",
    "caique": "*",
    "compat-oracle": "*",
    "flagstaff": "*",
    "linegauge": "^0.5.0",
    "paratext": "^0.6.0",
    "roundel": "*"
  },
  "devDependencies": {
    "ansi-escapes": "7.3.0",
    "boxen": "^8.0.1",
    "cac": "^7.0.0",
    "chalk": "^6.0.0",
    "cli-table3": "0.6.5",
    "commander": "^15.0.0",
    "cosmiconfig": "^10.0.1",
    "esbuild": "^0.28.0",
    "exit-hook": "^5.1.0",
    "log-update": "8.0.0",
    "ora": "9.4.1",
    "picocolors": "^1.1.1",
    "restore-cursor": "^5.1.0",
    "slice-ansi": "7.1.2",
    "string-width": "8.2.2",
    "strip-ansi": "7.2.0",
    "vitest": "^5.0.1",
    "wrap-ansi": "10.0.1",
    "yargs": "^18.0.0"
  }
}
