{
  "name": "@vendored/inkjs-ui-suite",
  "private": true,
  "type": "module",
  "main": "./shim.js",
  "version": "2.0.0",
  "license": "MIT",
  "description": "Collection of customizable UI components for CLIs made with Ink",
  "repository": "vadimdemedes/ink-ui",
  "devDependencies": {
    "@inkjs/ui": "2.0.0",
    "ink": "5.2.1",
    "react": "18.3.1",
    "ink-testing-library": "4.0.0",
    "ava": "5.3.1",
    "tsx": "4.23.15",
    "@sindresorhus/tsconfig": "5.1.1",
    "chalk": "5.6.2",
    "figures": "6.1.0",
    "delay": "6.0.0",
    "cli-spinners": "3.4.0",
    "cat-names": "4.0.0",
    "boxen": "7.1.1"
  },
  "ava": {
    "extensions": {
      "ts": "module",
      "tsx": "module"
    },
    "nodeArguments": [
      "--import=tsx"
    ],
    "environmentVariables": {
      "NODE_NO_WARNINGS": "1",
      "FORCE_COLOR": "true"
    }
  }
}
