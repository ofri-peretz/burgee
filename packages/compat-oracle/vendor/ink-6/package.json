{
  "name": "@vendored/ink-6-suite",
  "private": true,
  "type": "module",
  "main": "./shim.js",
  "version": "6.8.0",
  "license": "MIT",
  "description": "React for CLI",
  "repository": "vadimdemedes/ink",
  "devDependencies": {
    "ink": "6.8.0",
    "ava": "5.3.1",
    "tsx": "4.23.15",
    "@sindresorhus/tsconfig": "7.0.0",
    "react": "19.3.0",
    "node-pty": "1.2.0-beta.15",
    "sinon": "21.1.2",
    "@sinonjs/fake-timers": "15.4.0",
    "delay": "7.0.0",
    "strip-ansi": "7.2.0",
    "chalk": "5.6.2",
    "ansi-escapes": "7.3.0",
    "boxen": "8.0.1",
    "slice-ansi": "8.0.0",
    "patch-console": "2.0.0",
    "is-in-ci": "2.0.0",
    "indent-string": "5.0.0",
    "cli-boxes": "3.0.0"
  },
  "ava": {
    "workerThreads": false,
    "serial": true,
    "files": [
      "test/**/*",
      "!test/helpers/**/*",
      "!test/fixtures/**/*"
    ],
    "extensions": {
      "ts": "module",
      "tsx": "module"
    },
    "nodeArguments": [
      "--import=tsx"
    ]
  }
}
