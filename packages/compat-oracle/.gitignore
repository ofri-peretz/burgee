# Written per run by `grade()` in src/run.ts, and never committed: their contents name the
# target of that run, and the internal shims carry an absolute path from whichever machine
# produced them. `vendored-suite.test.ts` asserts every path listed here is really ignored —
# four of them were committed once, with `/Users/…/burgee-wave3/…` inside.
vendor/*/shim*.js
vendor/*/shim*.mjs
vendor/*/vitest.config.mjs
vendor/*/vitest.setup.mjs
# The generated internal shims, at whatever path a host files its own modules: `lib/` for
# commander and yargs, `src/` for cli-table3, `build/` where a host compiles first.
vendor/*/lib/
vendor/*/src/
vendor/*/build/
# Written by a *suite* rather than by the oracle, and upstream ignores both in its own
# repository (`node-cross-spawn/.gitignore`: `test/fixtures/(*` and `test/tmp/`). Its
# "special shell chars" case copies a fixture to a name made of them and never removes it,
# and its `beforeAll` makes `test/tmp`. Without these, running the suite dirties the
# worktree with two files whose names are `()%!^&;, ` and `()%!^&;, .bat` — which reads,
# to the next person, like something the vendor step produced.
vendor/cross-spawn/test/fixtures/(*
vendor/*/test/tmp/
results.json
results.control.json
upstream.json
vendor-diff.md
