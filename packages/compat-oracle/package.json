{
  "name": "compat-oracle",
  "version": "0.0.0",
  "description": "Grades burgee's compatibility against commander and yargs using their own test suites, plus reference drivers that run the real incumbents for byte-for-byte comparison. Internal; never published.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "burgee": "*"
  },
  "peerDependencies": {
    "commander": ">=12",
    "yargs": ">=17"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.33",
    "commander": "^15.0.0",
    "vitest": "^4.0.0",
    "yargs": "^18.0.0",
    "mocha": "^11.7.6",
    "chai": "^6.2.2",
    "which": "^2.0.2",
    "cross-spawn": "^7.0.6",
    "cpr": "^3.0.1",
    "yargs-test-extends": "^1.0.1",
    "chalk": "^5.6.2",
    "hashish": "0.0.4",
    "yargs-parser": "^22.0.0"
  },
  "exports": {
    "./drivers/commander": {
      "types": "./dist/drivers/commander.d.ts",
      "import": "./dist/drivers/commander.js"
    },
    "./drivers/yargs": {
      "types": "./dist/drivers/yargs.d.ts",
      "import": "./dist/drivers/yargs.js"
    }
  },
  "files": [
    "dist"
  ]
}
