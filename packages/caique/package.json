{
  "name": "caique",
  "version": "0.5.0",
  "description": "The parrot that always answers back, and the boat that goes between ship and shore. Prompts that are flags first, so agents answer before they are asked and non-TTY callers get an error naming the flag, never a hang. Drop-in path for inquirer and clack.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["./dist/cli.js"],
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ask": {
      "types": "./dist/ask.d.ts",
      "import": "./dist/ask.js",
      "default": "./dist/ask.js"
    },
    "./binding": {
      "types": "./dist/binding.d.ts",
      "import": "./dist/binding.js",
      "default": "./dist/binding.js"
    },
    "./clack": {
      "types": "./dist/clack.d.ts",
      "import": "./dist/clack.js",
      "default": "./dist/clack.js"
    },
    "./decide": {
      "types": "./dist/decide.d.ts",
      "import": "./dist/decide.js",
      "default": "./dist/decide.js"
    },
    "./inquirer": {
      "types": "./dist/inquirer.d.ts",
      "import": "./dist/inquirer.js",
      "default": "./dist/inquirer.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./raw": {
      "types": "./dist/raw.d.ts",
      "import": "./dist/raw.js",
      "default": "./dist/raw.js"
    },
    "./schema.json": "./dist/schema.json",
    "./spec": {
      "types": "./dist/spec.d.ts",
      "import": "./dist/spec.js",
      "default": "./dist/spec.js"
    },
    "./terminal": {
      "types": "./dist/terminal.d.ts",
      "import": "./dist/terminal.js",
      "default": "./dist/terminal.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/schema-to-dist.mjs && node ../../scripts/strip-comments.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage.enabled",
    "lint": "eslint src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/burgee.git",
    "directory": "packages/caique"
  },
  "homepage": "https://caique.interlace.tools",
  "bugs": {
    "url": "https://github.com/ofri-peretz/burgee/issues"
  },
  "keywords": [
    "cli",
    "terminal",
    "prompt",
    "prompts",
    "interactive",
    "inquirer",
    "clack",
    "agent",
    "non-tty",
    "plugin",
    "plugins",
    "extensible",
    "ai-agent"
  ],
  "dependencies": {
    "closeout": "^0.5.0",
    "linegauge": "^0.5.0"
  },
  "devDependencies": {
    "vitest": "^5.0.1"
  },
  "bin": {
    "caique": "./dist/cli.js"
  }
}
