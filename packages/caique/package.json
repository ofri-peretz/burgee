{
  "name": "caique",
  "version": "1.4.3",
  "description": "Prompts that are flags first: an agent passes the answer up front, and a non-TTY caller gets an error naming the flag, never a prompt that waits. No dependency outside the burgee family. Drop-in path for @inquirer/core.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/cli.js"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ask": {
      "types": "./dist/ask.d.ts",
      "import": "./dist/ask.js",
      "default": "./dist/ask.js"
    },
    "./binding": {
      "types": "./dist/binding.d.ts",
      "import": "./dist/binding.js",
      "default": "./dist/binding.js"
    },
    "./locale": {
      "types": "./dist/locale.d.ts",
      "import": "./dist/locale.js",
      "default": "./dist/locale.js"
    },
    "./clack": {
      "types": "./dist/clack.d.ts",
      "import": "./dist/clack.js",
      "default": "./dist/clack.js"
    },
    "./decide": {
      "types": "./dist/decide.d.ts",
      "import": "./dist/decide.js",
      "default": "./dist/decide.js"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js",
      "default": "./dist/editor.js"
    },
    "./inquirer": {
      "types": "./dist/inquirer.d.ts",
      "import": "./dist/inquirer.js",
      "default": "./dist/inquirer.js"
    },
    "./inquirer/prompts": {
      "types": "./dist/inquirer-prompts.d.ts",
      "import": "./dist/inquirer-prompts.js",
      "default": "./dist/inquirer-prompts.js"
    },
    "./keys": {
      "types": "./dist/keys.d.ts",
      "import": "./dist/keys.js",
      "default": "./dist/keys.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./raw": {
      "types": "./dist/raw.d.ts",
      "import": "./dist/raw.js",
      "default": "./dist/raw.js"
    },
    "./schema.json": "./dist/schema.json",
    "./spec": {
      "types": "./dist/spec.d.ts",
      "import": "./dist/spec.js",
      "default": "./dist/spec.js"
    },
    "./terminal": {
      "types": "./dist/terminal.d.ts",
      "import": "./dist/terminal.js",
      "default": "./dist/terminal.js"
    }
  },
  "typesVersions": {
    "*": {
      "ask": ["./dist/ask.d.ts"],
      "binding": ["./dist/binding.d.ts"],
      "locale": ["./dist/locale.d.ts"],
      "clack": ["./dist/clack.d.ts"],
      "decide": ["./dist/decide.d.ts"],
      "editor": ["./dist/editor.d.ts"],
      "inquirer": ["./dist/inquirer.d.ts"],
      "inquirer/prompts": ["./dist/inquirer-prompts.d.ts"],
      "keys": ["./dist/keys.d.ts"],
      "plugin": ["./dist/plugin.d.ts"],
      "raw": ["./dist/raw.d.ts"],
      "spec": ["./dist/spec.d.ts"],
      "terminal": ["./dist/terminal.d.ts"]
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/schema-to-dist.mjs && node ../../scripts/strip-comments.mjs dist && node ../../scripts/declaration-reach.mts --prune",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage.enabled",
    "lint": "eslint src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/burgee.git",
    "directory": "packages/caique"
  },
  "homepage": "https://caique.interlace.tools",
  "bugs": {
    "url": "https://github.com/ofri-peretz/burgee/issues"
  },
  "keywords": [
    "cli",
    "terminal",
    "prompt",
    "prompts",
    "interactive",
    "inquirer",
    "clack",
    "agent",
    "non-tty",
    "plugin",
    "plugins",
    "extensible",
    "ai-agent"
  ],
  "dependencies": {
    "closeout": "^1.1.4",
    "linegauge": "^1.1.2",
    "paratext": "^1.0.8",
    "roundel": "^1.1.2"
  },
  "devDependencies": {
    "vitest": "^5.0.1"
  },
  "bin": {
    "caique": "./dist/cli.js"
  }
}
