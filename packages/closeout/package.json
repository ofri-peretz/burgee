{
  "name": "closeout",
  "version": "0.3.0",
  "description": "Close everything out. Exit handlers that run exactly once on every path, terminal restore, and a bounded deadline so shutdown cannot hang. Drop-in paths for signal-exit, exit-hook and restore-cursor. Zero dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["./dist/cli.js"],
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema.json": "./dist/schema.json",
    "./once": {
      "types": "./dist/once.d.ts",
      "import": "./dist/once.js",
      "default": "./dist/once.js"
    },
    "./cursor": {
      "types": "./dist/cursor.d.ts",
      "import": "./dist/cursor.js",
      "default": "./dist/cursor.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./restore-cursor": {
      "types": "./dist/restore-cursor.d.ts",
      "import": "./dist/restore-cursor.js",
      "default": "./dist/restore-cursor.js"
    },
    "./exit-hook": {
      "types": "./dist/exit-hook.d.ts",
      "import": "./dist/exit-hook.js",
      "default": "./dist/exit-hook.js"
    },
    "./signal-exit": {
      "types": "./dist/signal-exit.d.cts",
      "import": "./dist/signal-exit.cjs",
      "default": "./dist/signal-exit.cjs"
    },
    "./signal-exit/signals": {
      "types": "./dist/signal-exit-signals.d.cts",
      "import": "./dist/signal-exit-signals.cjs",
      "default": "./dist/signal-exit-signals.cjs"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/schema-to-dist.mjs && node ../../scripts/strip-comments.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage.enabled",
    "lint": "eslint src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/burgee.git",
    "directory": "packages/closeout"
  },
  "homepage": "https://burgee.interlace.tools/docs/packages/closeout",
  "bugs": {
    "url": "https://github.com/ofri-peretz/burgee/issues"
  },
  "keywords": [
    "cli",
    "terminal",
    "exit",
    "signal",
    "signal-exit",
    "exit-hook",
    "cleanup",
    "shutdown",
    "restore-cursor",
    "teardown",
    "plugin",
    "plugins",
    "extensible",
    "agent",
    "ai-agent",
    "non-tty",
    "json",
    "zero-dependency"
  ],
  "devDependencies": {
    "vitest": "^5.0.1"
  },
  "bin": {
    "closeout": "./dist/cli.js"
  }
}
