import { type Client, type CreatePetInput, type DeletePetInput, type GetHealthInput, type GetPetInput, type GetPhotoInput, type ListPetsInput, type LoginInput, type UploadPhotoInput } from "./client.js";

/** A value with its object keys sorted at every depth: the same input in any property order is the same key. */
export const stable = (value: unknown): unknown => {
  if (Array.isArray(value)) return value.map(stable);
  if (typeof value !== "object" || value === null) return value;
  const record = value as Readonly<Record<string, unknown>>;
  return Object.fromEntries(Object.keys(record).sort().map((name) => [name, stable(record[name])]));
};

export const createPetMutationOptions = (client: Client) => ({
  mutationKey: ["createPet"] as const,
  mutationFn: async (input: CreatePetInput) => client["createPet"](input),
});

export const deletePetMutationOptions = (client: Client) => ({
  mutationKey: ["deletePet"] as const,
  mutationFn: async (input: DeletePetInput) => client["deletePet"](input),
});

export const getHealthQueryOptions = (client: Client, input: GetHealthInput = {}) => ({
  queryKey: ["get /health", stable(input)] as const,
  queryFn: async () => client["get /health"](input),
});

export const getPetQueryOptions = (client: Client, input: GetPetInput) => ({
  queryKey: ["getPet", stable(input)] as const,
  queryFn: async () => client["getPet"](input),
});

export const getPhotoQueryOptions = (client: Client, input: GetPhotoInput) => ({
  queryKey: ["getPhoto", stable(input)] as const,
  queryFn: async () => client["getPhoto"](input),
});

export const listPetsQueryOptions = (client: Client, input: ListPetsInput = {}) => ({
  queryKey: ["listPets", stable(input)] as const,
  queryFn: async () => client["listPets"](input),
});

export const loginMutationOptions = (client: Client) => ({
  mutationKey: ["login"] as const,
  mutationFn: async (input: LoginInput) => client["login"](input),
});

export const uploadPhotoMutationOptions = (client: Client) => ({
  mutationKey: ["uploadPhoto"] as const,
  mutationFn: async (input: UploadPhotoInput) => client["uploadPhoto"](input),
});
