{
  "name": "apicontract",
  "version": "0.0.1",
  "private": true,
  "description": "A CLI that turns specs into code and code into specs, through plugins: TypeScript types, validators, NestJS modules, and the spec back from each. Codename; unpublished until the naming pass.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "apicontract": "./dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage.enabled",
    "lint": "eslint src"
  },
  "dependencies": {
    "burgee": "^2.0.0"
  },
  "devDependencies": {
    "vitest": "^5.0.1"
  }
}
