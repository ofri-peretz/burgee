{
  "name": "controlroom",
  "version": "0.2.0",
  "description": "Keyboard-driven terminal screens, inline or full-screen, with a static projection for pipes, CI and --json — and a drop-in path for ink, graded by ink's own suite. No dependency outside the burgee family; react is an optional peer of controlroom/ink only.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/cli.js"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "bin": {
    "controlroom": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ink": {
      "types": "./dist/ink/index.d.ts",
      "import": "./dist/ink/index.js",
      "default": "./dist/ink/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./schema.json": "./dist/schema.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/schema-to-dist.mjs && node ../../scripts/strip-comments.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage.enabled",
    "lint": "eslint src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/burgee.git",
    "directory": "packages/controlroom"
  },
  "homepage": "https://burgee.interlace.tools/docs/packages/controlroom",
  "bugs": {
    "url": "https://github.com/ofri-peretz/burgee/issues"
  },
  "keywords": [
    "cli",
    "terminal",
    "tui",
    "screen",
    "fullscreen",
    "layout",
    "panes",
    "tabs",
    "keyboard",
    "ink",
    "non-tty",
    "zero-dependency"
  ],
  "dependencies": {
    "caique": "^0.7.1",
    "closeout": "^0.7.0",
    "flagstaff": "^1.1.1",
    "linegauge": "^1.0.4",
    "paratext": "^0.9.0",
    "roundel": "^0.6.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-reconciler": ">=0.29.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-reconciler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "react-reconciler": "^0.34.0",
    "vitest": "^5.0.1"
  }
}
