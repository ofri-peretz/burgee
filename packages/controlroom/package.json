{
  "name": "controlroom",
  "version": "0.0.1",
  "description": "Reserved, and not usable yet: full-screen, keyboard-driven terminal screens with a static projection for pipes, CI and --json. The planned drop-in path for ink. Its only export today is status = 'reserved'.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/strip-comments.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage.enabled",
    "lint": "eslint src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/burgee.git",
    "directory": "packages/controlroom"
  },
  "homepage": "https://burgee.interlace.tools/docs/packages/controlroom",
  "bugs": {
    "url": "https://github.com/ofri-peretz/burgee/issues"
  },
  "keywords": [
    "cli",
    "terminal",
    "tui",
    "screen",
    "fullscreen",
    "layout",
    "panes",
    "tabs",
    "keyboard",
    "ink",
    "non-tty",
    "zero-dependency"
  ],
  "dependencies": {
    "linegauge": "^1.0.3"
  },
  "devDependencies": {
    "vitest": "^5.0.1"
  }
}
