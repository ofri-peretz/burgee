{
  "name": "flagstaff",
  "version": "1.7.3",
  "description": "Spinners, progress, boxes and tables on one terminal frame loop, with a static projection for pipes, screen readers and agents, and a plugin host. No dependency outside the burgee family. Drop-in paths for ora, log-update, boxen and cli-table3.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["./dist/cli.js", "./dist/log-tail.js", "./dist/tab-bar.js"],
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ora": {
      "types": "./dist/ora.d.ts",
      "import": "./dist/ora.js",
      "default": "./dist/ora.js"
    },
    "./boxen": {
      "types": "./dist/boxen.d.ts",
      "import": "./dist/boxen.js",
      "default": "./dist/boxen.js"
    },
    "./cli-table3": {
      "types": "./dist/cli-table3.d.ts",
      "import": "./dist/cli-table3.js",
      "default": "./dist/cli-table3.js"
    },
    "./log-update": {
      "types": "./dist/log-update.d.ts",
      "import": "./dist/log-update.js",
      "default": "./dist/log-update.js"
    },
    "./loop": {
      "types": "./dist/loop.d.ts",
      "import": "./dist/loop.js",
      "default": "./dist/loop.js"
    },
    "./package.json": "./package.json",
    "./schema.json": "./dist/schema.json",
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./import": {
      "types": "./dist/import.d.ts",
      "import": "./dist/import.js",
      "default": "./dist/import.js"
    },
    "./spinner": {
      "types": "./dist/spinner.d.ts",
      "import": "./dist/spinner.js",
      "default": "./dist/spinner.js"
    },
    "./progress": {
      "types": "./dist/progress.d.ts",
      "import": "./dist/progress.js",
      "default": "./dist/progress.js"
    },
    "./tasks": {
      "types": "./dist/tasks.d.ts",
      "import": "./dist/tasks.js",
      "default": "./dist/tasks.js"
    },
    "./log-tail": {
      "types": "./dist/log-tail.d.ts",
      "import": "./dist/log-tail.js",
      "default": "./dist/log-tail.js"
    },
    "./tab-bar": {
      "types": "./dist/tab-bar.d.ts",
      "import": "./dist/tab-bar.js",
      "default": "./dist/tab-bar.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js",
      "default": "./dist/markdown.js"
    },
    "./diff": {
      "types": "./dist/diff.d.ts",
      "import": "./dist/diff.js",
      "default": "./dist/diff.js"
    },
    "./box": {
      "types": "./dist/box.d.ts",
      "import": "./dist/box.js",
      "default": "./dist/box.js"
    },
    "./table": {
      "types": "./dist/table.d.ts",
      "import": "./dist/table.js",
      "default": "./dist/table.js"
    }
  },
  "typesVersions": {
    "*": {
      "ora": ["./dist/ora.d.ts"],
      "boxen": ["./dist/boxen.d.ts"],
      "cli-table3": ["./dist/cli-table3.d.ts"],
      "log-update": ["./dist/log-update.d.ts"],
      "loop": ["./dist/loop.d.ts"],
      "plugin": ["./dist/plugin.d.ts"],
      "import": ["./dist/import.d.ts"],
      "spinner": ["./dist/spinner.d.ts"],
      "progress": ["./dist/progress.d.ts"],
      "tasks": ["./dist/tasks.d.ts"],
      "log-tail": ["./dist/log-tail.d.ts"],
      "tab-bar": ["./dist/tab-bar.d.ts"],
      "markdown": ["./dist/markdown.d.ts"],
      "diff": ["./dist/diff.d.ts"],
      "box": ["./dist/box.d.ts"],
      "table": ["./dist/table.d.ts"]
    }
  },
  "bin": {
    "flagstaff": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.test.*",
    "THIRD-PARTY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/schema-to-dist.mjs && node ../../scripts/strip-comments.mjs dist && node ../../scripts/declaration-reach.mts --prune",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage.enabled",
    "lint": "eslint src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/burgee.git",
    "directory": "packages/flagstaff"
  },
  "homepage": "https://flagstaff.interlace.tools",
  "bugs": {
    "url": "https://github.com/ofri-peretz/burgee/issues"
  },
  "keywords": [
    "cli",
    "terminal",
    "spinner",
    "progress",
    "render",
    "animation",
    "ora",
    "log-update",
    "boxen",
    "cli-table3",
    "plugins",
    "plugin",
    "extensible",
    "agent",
    "ai-agent",
    "non-tty",
    "json"
  ],
  "dependencies": {
    "closeout": "^1.1.6",
    "linegauge": "^1.1.4",
    "paratext": "^1.0.10",
    "roundel": "^1.2.0"
  },
  "devDependencies": {
    "fast-check": "^4.10.2",
    "vitest": "^5.0.1"
  }
}
