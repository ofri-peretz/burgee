{
  "name": "flagstaff",
  "version": "0.0.1",
  "description": "The staff the flag flies from. A terminal frame loop with a static projection for agents and screen readers, and a plugin host for spinners, progress, boxes and tables. Drop-in paths for ora, log-update, boxen and cli-table3. Zero dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ora": {
      "types": "./dist/ora.d.ts",
      "import": "./dist/ora.js",
      "default": "./dist/ora.js"
    },
    "./loop": {
      "types": "./dist/loop.d.ts",
      "import": "./dist/loop.js",
      "default": "./dist/loop.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./spinner": {
      "types": "./dist/spinner.d.ts",
      "import": "./dist/spinner.js",
      "default": "./dist/spinner.js"
    }
  },
  "bin": {
    "flagstaff": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.test.*",
    "THIRD-PARTY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/strip-comments.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/burgee.git",
    "directory": "packages/flagstaff"
  },
  "homepage": "https://github.com/ofri-peretz/burgee/tree/main/packages/flagstaff#readme",
  "bugs": {
    "url": "https://github.com/ofri-peretz/burgee/issues"
  },
  "keywords": [
    "cli",
    "terminal",
    "spinner",
    "progress",
    "render",
    "animation",
    "ora",
    "log-update",
    "boxen",
    "cli-table3",
    "plugins"
  ],
  "dependencies": {
    "roundel": "^0.0.1"
  },
  "devDependencies": {
    "string-width": "^8.1.0",
    "vitest": "^4.0.0"
  }
}
