{
  "type": "object",
  "required": [
    "name"
  ],
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "contract": {
      "type": "integer",
      "minimum": 1
    },
    "tokens": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      },
      "propertyNames": {
        "enum": [
          "error",
          "warn",
          "ok",
          "hint",
          "muted",
          "command",
          "flag",
          "value",
          "heading",
          "ground"
        ]
      }
    },
    "glyphs": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "spinners": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/spinner"
      }
    },
    "borders": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/border"
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "$defs": {
    "spinner": {
      "type": "object",
      "required": [
        "frames",
        "interval",
        "static"
      ],
      "properties": {
        "frames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "interval": {
          "type": "integer",
          "minimum": 1
        },
        "static": {
          "type": "string"
        }
      }
    },
    "component": {
      "type": "object",
      "required": [
        "static"
      ],
      "properties": {
        "static": {},
        "frame": {},
        "sample": {
          "type": "object",
          "required": [
            "running",
            "done"
          ],
          "properties": {
            "running": {},
            "done": {}
          }
        },
        "interval": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "border": {
      "type": "object",
      "required": [
        "topLeft",
        "top",
        "topRight",
        "left",
        "right",
        "bottomLeft",
        "bottom",
        "bottomRight"
      ],
      "properties": {
        "topLeft": {
          "type": "string"
        },
        "top": {
          "type": "string"
        },
        "topRight": {
          "type": "string"
        },
        "left": {
          "type": "string"
        },
        "right": {
          "type": "string"
        },
        "bottomLeft": {
          "type": "string"
        },
        "bottom": {
          "type": "string"
        },
        "bottomRight": {
          "type": "string"
        }
      }
    }
  }
}
