{
  "name": "provedone",
  "version": "1.0.0",
  "description": "Verified commits for JS and TS repos: each commit carries a receipt of the command that proved it, each intent a done check, and a gate reads both. No dependency outside the burgee family. A @commitlint/cli migration path.",
  "license": "MIT",
  "author": "Ofri Peretz <ofriperetzdev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/burgee.git",
    "directory": "packages/provedone"
  },
  "bugs": {
    "url": "https://github.com/ofri-peretz/burgee/issues"
  },
  "homepage": "https://burgee.interlace.tools",
  "type": "module",
  "private": false,
  "sideEffects": [
    "./dist/bin.js"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "provedone": "dist/bin.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {}
  },
  "keywords": [
    "verification",
    "definition-of-done",
    "commit-trailer",
    "pull-request",
    "pre-push",
    "lefthook",
    "git-hooks",
    "ai-agents",
    "cli"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/strip-comments.mjs dist && node ../../scripts/declaration-reach.mts --prune",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage.enabled",
    "lint": "eslint src"
  },
  "dependencies": {
    "bellpull": "^2.0.3",
    "burgee": "^2.2.1"
  },
  "devDependencies": {
    "vitest": "^5.0.1"
  }
}
