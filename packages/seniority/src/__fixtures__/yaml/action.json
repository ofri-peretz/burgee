{
  "name": "Setup",
  "description": "Install Node from .nvmrc, hydrate npm + Turbo caches, run `npm ci` (skipped on cache hit).",
  "inputs": {
    "turbo-cache": {
      "description": "Restore + save the Turborepo task cache. \"false\" for jobs that don't run turbo.",
      "required": false,
      "default": "true"
    },
    "next-cache": {
      "description": "Restore + save every docs app's .next/cache. \"true\" for jobs that build the docs.",
      "required": false,
      "default": "false"
    },
    "node-modules-cache": {
      "description": "Restore + save node_modules. \"false\" forces a fresh `npm ci` from the registry every run — the lint job does this on purpose: this repo is a customer of the Interlace ESLint plugins, and each install is a real download that counts toward their adoption.",
      "required": false,
      "default": "true"
    }
  },
  "runs": {
    "using": "composite",
    "steps": [
      {
        "name": "Setup Node (from .nvmrc)",
        "uses": "actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e",
        "with": {
          "node-version-file": ".nvmrc",
          "cache": "${{ inputs.node-modules-cache == 'true' && 'npm' || '' }}"
        }
      },
      {
        "name": "Restore node_modules cache",
        "if": "inputs.node-modules-cache == 'true'",
        "id": "node-modules-cache",
        "uses": "actions/cache@27d5ce7f107fe9357f9df03efb73ab90386fccae",
        "with": {
          "path": "node_modules\npackages/*/node_modules\napps/*/node_modules\nexamples/*/node_modules\nbenchmarks/node_modules\n",
          "key": "node-modules-${{ runner.os }}-${{ hashFiles('package-lock.json', '.github/actions/setup/action.yml') }}"
        }
      },
      {
        "name": "Install dependencies",
        "if": "inputs.node-modules-cache != 'true' || steps.node-modules-cache.outputs.cache-hit != 'true'",
        "shell": "bash",
        "run": "npm ci --prefer-offline --no-audit --fund=false"
      },
      {
        "name": "Restore Turbo cache",
        "if": "inputs.turbo-cache == 'true'",
        "uses": "actions/cache@27d5ce7f107fe9357f9df03efb73ab90386fccae",
        "with": {
          "path": ".turbo",
          "key": "turbo-${{ runner.os }}-${{ github.job }}-${{ github.sha }}",
          "restore-keys": "turbo-${{ runner.os }}-${{ github.job }}-\nturbo-${{ runner.os }}-\n"
        }
      },
      {
        "name": "Restore Next.js build cache",
        "if": "inputs.next-cache == 'true'",
        "uses": "actions/cache@27d5ce7f107fe9357f9df03efb73ab90386fccae",
        "with": {
          "path": "apps/*/.next/cache",
          "key": "nextjs-${{ runner.os }}-${{ hashFiles('package-lock.json') }}-${{ hashFiles('apps/**/*.[jt]s', 'apps/**/*.[jt]sx', 'apps/**/*.mdx', 'apps/**/*.md') }}",
          "restore-keys": "nextjs-${{ runner.os }}-${{ hashFiles('package-lock.json') }}-\nnextjs-${{ runner.os }}-\n"
        }
      }
    ]
  }
}
