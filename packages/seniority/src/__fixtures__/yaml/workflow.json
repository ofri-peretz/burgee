{
  "name": "Compatibility",
  "on": {
    "pull_request": null,
    "push": {
      "branches": [
        "main"
      ]
    },
    "merge_group": null,
    "workflow_dispatch": null
  },
  "concurrency": {
    "group": "compat-${{ github.ref }}",
    "cancel-in-progress": true
  },
  "permissions": {
    "contents": "read"
  },
  "jobs": {
    "ratchet": {
      "name": "Ratchet · each host's suite against burgee",
      "runs-on": "ubuntu-latest",
      "timeout-minutes": 20,
      "permissions": {
        "contents": "read",
        "issues": "write"
      },
      "steps": [
        {
          "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1"
        },
        {
          "uses": "./.github/actions/setup"
        },
        {
          "name": "Build",
          "run": "npx turbo run build --filter='./packages/*'"
        },
        {
          "name": "Grade burgee (fails below baseline)",
          "shell": "bash",
          "run": "node packages/compat-oracle/dist/bin.js 2>&1 | tee compat.log"
        },
        {
          "name": "Grade the real packages, so the page has its control column",
          "shell": "bash",
          "run": "node packages/compat-oracle/dist/bin.js --control 2>&1 | tee -a compat.log"
        },
        {
          "name": "Grade burgee against the previous majors (C1, fails below baseline)",
          "shell": "bash",
          "run": "node packages/compat-oracle/dist/bin.js --majors 2>&1 | tee -a compat.log"
        },
        {
          "name": "Grade the previous majors' real packages",
          "shell": "bash",
          "run": "node packages/compat-oracle/dist/bin.js --majors --control 2>&1 | tee -a compat.log"
        },
        {
          "name": "The published page is the one these results generate",
          "run": "npm run compat:page -- --check"
        },
        {
          "name": "Summary",
          "if": "always()",
          "run": "{ echo '## Compatibility'; echo; echo '```'; cat compat.log || echo '(no output)'; echo '```'; } >> \"$GITHUB_STEP_SUMMARY\"\n"
        },
        {
          "uses": "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a",
          "if": "always()",
          "with": {
            "name": "compat-results",
            "path": "packages/compat-oracle/results.json",
            "if-no-files-found": "ignore",
            "retention-days": 30
          }
        },
        {
          "name": "Say so — a red main is an outage",
          "if": "failure() && github.event_name == 'push'",
          "env": {
            "GH_TOKEN": "${{ github.token }}",
            "RUN_URL": "${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}",
            "SHA": "${{ github.sha }}"
          },
          "run": "set -euo pipefail\nTITLE=\"main is red — the compatibility ratchet failed after a merge\"\nEXISTING=$(gh issue list --state open --search \"$TITLE in:title\" --json number --jq '.[0].number // empty')\nBODY=$(printf 'The ratchet failed on a push to main, so main is broken now and every branch cut from it inherits it. The merge that did it is `%s`.\\n\\nMost likely the published `compatibility.mdx` no longer matches what the oracle measures — rebuild, run `packages/compat-oracle/dist/bin.js --control` then without flags, then `npm run compat:page`, and commit the page.\\n\\n[Run](%s)\\n' \"$SHA\" \"$RUN_URL\")\nif [ -z \"$EXISTING\" ]; then\n  gh issue create --title \"$TITLE\" --body \"$BODY\"\nelse\n  echo \"already open as #$EXISTING\"\nfi\n"
        }
      ]
    },
    "matrix": {
      "name": "Node ${{ matrix.node }} · ${{ matrix.os }}",
      "runs-on": "${{ matrix.os }}",
      "timeout-minutes": 30,
      "strategy": {
        "fail-fast": false,
        "matrix": {
          "os": [
            "ubuntu-latest",
            "macos-latest",
            "windows-latest"
          ],
          "node": [
            24,
            26
          ]
        }
      },
      "steps": [
        {
          "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1"
        },
        {
          "uses": "actions/setup-node@820762786026740c76f36085b0efc47a31fe5020",
          "with": {
            "node-version": "${{ matrix.node }}",
            "cache": "npm"
          }
        },
        {
          "run": "npm ci --ignore-scripts"
        },
        {
          "run": "npm run build -- ${{ matrix.os == 'macos-latest' && '--concurrency=2' || '' }}"
        },
        {
          "name": "Our suite (hard gate on every cell)",
          "run": "npm test"
        },
        {
          "name": "Controls (informational off Linux)",
          "continue-on-error": "${{ matrix.os != 'ubuntu-latest' }}",
          "run": "node packages/compat-oracle/dist/bin.js --control"
        }
      ]
    },
    "floor": {
      "name": "Node ${{ matrix.node }} · ${{ matrix.os }} · published suites",
      "runs-on": "${{ matrix.os }}",
      "timeout-minutes": 30,
      "strategy": {
        "fail-fast": false,
        "matrix": {
          "os": [
            "ubuntu-latest",
            "macos-latest",
            "windows-latest"
          ],
          "node": [
            "20.19.0",
            "22.13.0"
          ]
        }
      },
      "steps": [
        {
          "uses": "actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1"
        },
        {
          "uses": "./.github/actions/setup"
        },
        {
          "name": "Build on the .nvmrc Node — the dist npm ships",
          "run": "npx turbo run build --filter='./packages/*'"
        },
        {
          "uses": "actions/setup-node@820762786026740c76f36085b0efc47a31fe5020",
          "with": {
            "node-version": "${{ matrix.node }}",
            "cache": "npm"
          }
        },
        {
          "name": "Every published package's suite (hard gate on every cell)",
          "shell": "bash",
          "run": "set -uo pipefail\nnode --version\nfailed=()\nfor dir in packages/*/; do\n  name=$(basename \"$dir\")\n  [ \"$(node -p \"require('./${dir}package.json').private === true\")\" = true ] && continue\n  echo \"::group::$name\"\n  (cd \"$dir\" && npx vitest run) || failed+=(\"$name\")\n  echo \"::endgroup::\"\ndone\nif [ ${#failed[@]} -gt 0 ]; then echo \"::error::red on Node $(node --version): ${failed[*]}\"; exit 1; fi\n"
        }
      ]
    }
  }
}
