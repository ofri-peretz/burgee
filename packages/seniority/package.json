{
  "name": "seniority",
  "version": "0.4.2",
  "description": "Which source outranks the others. One resolution for flags, environment, project and home config files and defaults \u2014 with provenance, so every value can say where it came from. Drop-in paths for cosmiconfig, dotenv and rc. Zero dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["./dist/cli.js"],
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./precedence": {
      "types": "./dist/precedence.d.ts",
      "import": "./dist/precedence.js",
      "default": "./dist/precedence.js"
    },
    "./explain": {
      "types": "./dist/explain-entry.d.ts",
      "import": "./dist/explain-entry.js",
      "default": "./dist/explain-entry.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./cosmiconfig": {
      "types": "./dist/cosmiconfig.d.ts",
      "import": "./dist/cosmiconfig.js",
      "default": "./dist/cosmiconfig.js"
    },
    "./dotenv": {
      "types": "./dist/dotenv.d.ts",
      "import": "./dist/dotenv.js",
      "default": "./dist/dotenv.js"
    },
    "./lilconfig": {
      "types": "./dist/lilconfig.d.ts",
      "import": "./dist/lilconfig.js",
      "default": "./dist/lilconfig.js"
    },
    "./rc": {
      "types": "./dist/rc.d.ts",
      "import": "./dist/rc.js",
      "default": "./dist/rc.js"
    },
    "./find-up": {
      "types": "./dist/find-up.d.ts",
      "import": "./dist/find-up.js",
      "default": "./dist/find-up.js"
    },
    "./schema.json": "./dist/schema.json",
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/schema-to-dist.mjs && node ../../scripts/strip-comments.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage.enabled",
    "lint": "eslint src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/burgee.git",
    "directory": "packages/seniority"
  },
  "homepage": "https://burgee.interlace.tools/docs/packages/seniority",
  "bugs": {
    "url": "https://github.com/ofri-peretz/burgee/issues"
  },
  "keywords": [
    "cli",
    "config",
    "configuration",
    "cosmiconfig",
    "dotenv",
    "rc",
    "lilconfig",
    "precedence",
    "env",
    "settings",
    "provenance",
    "plugin",
    "plugins",
    "extensible",
    "agent",
    "ai-agent",
    "json",
    "zero-dependency"
  ],
  "devDependencies": {
    "vitest": "^5.0.1"
  },
  "bin": {
    "seniority": "./dist/cli.js"
  }
}
