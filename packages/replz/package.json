{
  "name": "replz",
  "version": "1.0.1",
  "private": false,
  "description": "Code review benchmark for AI reviewers and a repo's checks: replays each pull request a revert or fix blamed beside clean controls, and grades findings against a one-line answer key. No dependency outside the burgee family. A promptfoo migration path.",
  "keywords": [
    "code-review",
    "ai-review",
    "benchmark",
    "regression",
    "bug-replay",
    "precision",
    "recall",
    "ci",
    "cli"
  ],
  "license": "MIT",
  "homepage": "https://burgee.interlace.tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/burgee.git",
    "directory": "packages/replz"
  },
  "bugs": {
    "url": "https://github.com/ofri-peretz/burgee/issues"
  },
  "author": "Ofri Peretz <ofriperetzdev@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "replz": "dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/strip-comments.mjs dist && node ../../scripts/declaration-reach.mts --prune",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage.enabled",
    "lint": "cd ../.. && eslint packages/replz/src --max-warnings 0"
  },
  "dependencies": {
    "bellpull": "^2.0.0",
    "burgee": "^2.1.5",
    "seniority": "^2.0.0",
    "truefit": "^1.0.1"
  },
  "devDependencies": {
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": [
    "./dist/bin.js"
  ],
  "typesVersions": {
    "*": {}
  }
}
