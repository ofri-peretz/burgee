{
  "name": "triggerlist",
  "version": "0.3.0",
  "private": false,
  "description": "Code review checklist that the diff selects: only items whose triggers fire reach the reviewer, REVIEW.md compiles under a byte budget, and rules are read from the base branch. No dependency outside the burgee family. A danger migration path.",
  "keywords": [
    "code-review",
    "checklist",
    "ai-review",
    "pull-request",
    "review-rules",
    "diff",
    "ci",
    "cli"
  ],
  "license": "MIT",
  "homepage": "https://burgee.interlace.tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/burgee.git",
    "directory": "packages/triggerlist"
  },
  "bugs": {
    "url": "https://github.com/ofri-peretz/burgee/issues"
  },
  "author": "Ofri Peretz <ofriperetzdev@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "triggerlist": "dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/strip-comments.mjs dist && node ../../scripts/declaration-reach.mts --prune",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage.enabled",
    "lint": "eslint src"
  },
  "dependencies": {
    "bellpull": "^2.0.0",
    "burgee": "^2.0.0",
    "seniority": "^2.0.0",
    "truefit": "^0.2.1"
  },
  "devDependencies": {
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": [
    "./dist/bin.js"
  ],
  "typesVersions": {
    "*": {}
  }
}
