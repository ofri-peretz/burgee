{
  "name": "triggerlist",
  "version": "0.0.0",
  "private": true,
  "description": "A review checklist the diff selects: only the items whose triggers fire reach the reviewer, REVIEW.md is compiled under a byte budget, and the checklist is read from the base branch so a change cannot edit its own checks. Working name; unpublished.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "triggerlist": "./dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage.enabled",
    "lint": "eslint src"
  },
  "dependencies": {
    "bellpull": "^2.0.0",
    "burgee": "^2.0.0",
    "seniority": "^2.0.0",
    "validator": "0.0.1"
  },
  "devDependencies": {
    "vitest": "^5.0.1"
  }
}
