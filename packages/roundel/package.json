{
  "name": "roundel",
  "version": "0.0.1",
  "description": "The colours a CLI carries. One output policy, semantic tokens, a theme, and a chalk migration path lighter than chalk. Zero dependencies.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.js",
      "default": "./dist/policy.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js",
      "default": "./dist/tokens.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "default": "./dist/theme.js"
    },
    "./contrast": {
      "types": "./dist/contrast.d.ts",
      "import": "./dist/contrast.js",
      "default": "./dist/contrast.js"
    },
    "./chalk": {
      "types": "./dist/chalk.d.ts",
      "import": "./dist/chalk.js",
      "default": "./dist/chalk.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/strip-comments.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/burgee.git",
    "directory": "packages/roundel"
  },
  "homepage": "https://github.com/ofri-peretz/burgee/tree/main/packages/roundel#readme",
  "bugs": {
    "url": "https://github.com/ofri-peretz/burgee/issues"
  },
  "keywords": [
    "cli",
    "terminal",
    "color",
    "colour",
    "ansi",
    "style",
    "theme",
    "chalk",
    "picocolors",
    "styleText"
  ],
  "devDependencies": {
    "vitest": "^5.0.0"
  }
}
