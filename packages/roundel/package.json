{
  "name": "roundel",
  "version": "1.2.0",
  "description": "Colour for a CLI: one output policy decided from the runtime, nine semantic tokens over util.styleText, and a theme that changes them together, contrast-checked. Zero dependencies. Drop-in paths for chalk, picocolors and supports-color.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["./dist/cli.js"],
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.js",
      "default": "./dist/policy.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js",
      "default": "./dist/tokens.js"
    },
    "./package.json": "./package.json",
    "./schema.json": "./dist/schema.json",
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "default": "./dist/theme.js"
    },
    "./contrast": {
      "types": "./dist/contrast.d.ts",
      "import": "./dist/contrast.js",
      "default": "./dist/contrast.js"
    },
    "./chalk": {
      "types": "./dist/chalk.d.ts",
      "import": "./dist/chalk.js",
      "default": "./dist/chalk.js"
    },
    "./picocolors": {
      "types": "./dist/picocolors.d.ts",
      "import": "./dist/picocolors.js",
      "default": "./dist/picocolors.js"
    },
    "./supports-color": {
      "types": "./dist/supports-color.d.ts",
      "import": "./dist/supports-color.js",
      "default": "./dist/supports-color.js"
    },
    "./terminal": {
      "types": "./dist/terminal.d.ts",
      "import": "./dist/terminal.js",
      "default": "./dist/terminal.js"
    },
    "./import": {
      "types": "./dist/import.d.ts",
      "import": "./dist/import.js",
      "default": "./dist/import.js"
    }
  },
  "typesVersions": {
    "*": {
      "policy": ["./dist/policy.d.ts"],
      "tokens": ["./dist/tokens.d.ts"],
      "plugin": ["./dist/plugin.d.ts"],
      "theme": ["./dist/theme.d.ts"],
      "contrast": ["./dist/contrast.d.ts"],
      "chalk": ["./dist/chalk.d.ts"],
      "picocolors": ["./dist/picocolors.d.ts"],
      "supports-color": ["./dist/supports-color.d.ts"],
      "terminal": ["./dist/terminal.d.ts"],
      "import": ["./dist/import.d.ts"]
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/schema-to-dist.mjs && node ../../scripts/strip-comments.mjs dist && node ../../scripts/declaration-reach.mts --prune",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage.enabled",
    "lint": "eslint src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/burgee.git",
    "directory": "packages/roundel"
  },
  "homepage": "https://roundel.interlace.tools",
  "bugs": {
    "url": "https://github.com/ofri-peretz/burgee/issues"
  },
  "keywords": [
    "cli",
    "terminal",
    "color",
    "colour",
    "ansi",
    "style",
    "theme",
    "chalk",
    "picocolors",
    "supports-color",
    "styleText",
    "plugin",
    "plugins",
    "extensible",
    "non-tty",
    "json",
    "zero-dependency"
  ],
  "devDependencies": {
    "vitest": "^5.0.1"
  },
  "bin": {
    "roundel": "./dist/cli.js"
  }
}
