{
  "name": "@interlace/cli-core",
  "version": "0.0.0",
  "description": "Internal shared contract for the commander-* and yargs-* extensions: exit codes, output envelope, error type, manifest schema. Zero dependencies.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/cli.git",
    "directory": "packages/cli-core"
  },
  "keywords": [
    "cli",
    "commander",
    "yargs",
    "ai-agents",
    "interlace"
  ],
  "devDependencies": {
    "vitest": "^4.0.0"
  }
}
