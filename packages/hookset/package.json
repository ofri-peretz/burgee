{
  "name": "hookset",
  "version": "1.0.0",
  "private": false,
  "description": "Git hooks presets for AI coding agents: lefthook presets pulled by a pinned tag, a Claude Code hook pack that denies skipped hooks, and `hookset init` and `check`. No dependency outside the burgee family. A husky migration path.",
  "keywords": [
    "git-hooks",
    "lefthook",
    "pre-commit",
    "pre-push",
    "commit-msg",
    "claude-code",
    "ai-agents",
    "verification",
    "cli"
  ],
  "license": "MIT",
  "homepage": "https://hookset.interlace.tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/burgee.git",
    "directory": "packages/hookset"
  },
  "bugs": {
    "url": "https://github.com/ofri-peretz/burgee/issues"
  },
  "author": "Ofri Peretz <ofriperetzdev@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "hookset": "dist/bin.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.test.*",
    "presets",
    "claude",
    "stations.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/strip-comments.mjs dist && node ../../scripts/declaration-reach.mts --prune",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage.enabled",
    "lint": "eslint src"
  },
  "dependencies": {
    "burgee": "^2.1.3"
  },
  "devDependencies": {
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": [
    "./dist/bin.js"
  ],
  "typesVersions": {
    "*": {}
  }
}
