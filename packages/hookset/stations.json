{
  "$comment": "The verification stations hookset wires, as data. proofline reads the same ids for its Checked line. A station in observe mode is wired with --if-present, so a repo that has not declared its script passes.",
  "remote": "https://github.com/ofri-peretz/burgee",
  "tagPrefix": "hookset@",
  "presets": {
    "commit-msg": "packages/hookset/presets/lefthook/commit-msg.yml",
    "pre-commit": "packages/hookset/presets/lefthook/pre-commit.yml",
    "pre-push": "packages/hookset/presets/lefthook/pre-push.yml"
  },
  "stations": [
    { "id": "commitlint", "hook": "commit-msg", "mode": "enforce", "command": "hookset-commitlint", "detail": "the message follows the repo's commitlint config" },
    { "id": "provedone", "hook": "commit-msg", "mode": "enforce", "command": "hookset-provedone", "script": "hook:provedone", "detail": "the commit carries a Verified-by receipt, or none with a reason" },
    { "id": "staged", "hook": "pre-commit", "mode": "enforce", "command": "hookset-staged", "script": "hook:staged", "detail": "lint and format the staged files only, under 10 s" },
    { "id": "verify", "hook": "pre-push", "mode": "enforce", "command": "hookset-verify", "script": "hook:verify", "detail": "typecheck, the affected tests and the build" },
    { "id": "mutation", "hook": "pre-push", "mode": "optional", "command": "hookset-mutation", "script": "hook:mutation", "detail": "changed-lines mutation testing" },
    { "id": "test-integrity", "hook": "pre-push", "mode": "observe", "command": "hookset-test-integrity", "script": "hook:test-integrity", "detail": "no .only, .skip or weakened assertion in the diff" },
    { "id": "proofline", "hook": "pre-push", "mode": "observe", "command": "hookset-proofline", "script": "hook:proofline", "detail": "the change carries its Checked line" },
    { "id": "triggerlist", "hook": "pre-push", "mode": "observe", "command": "hookset-triggerlist", "script": "hook:triggerlist", "detail": "protected paths changed only with their trigger" }
  ],
  "claude": {
    "files": ["guard-bash.mjs", "stop-after-3.mjs", "verify-before-stop.mjs", "codegraph.mjs", "worktree-sweep.mjs"],
    "hooks": [
      { "event": "PreToolUse", "matcher": "Bash", "file": "guard-bash.mjs", "timeout": 10 },
      { "event": "PreToolUse", "matcher": "Edit|Write|MultiEdit|NotebookEdit", "file": "guard-bash.mjs", "timeout": 10 },
      { "event": "PostToolUse", "matcher": "Bash", "file": "stop-after-3.mjs", "timeout": 10 },
      { "event": "PreToolUse", "matcher": "Bash", "file": "verify-before-stop.mjs", "timeout": 30 },
      { "event": "PostToolUse", "matcher": "Bash", "file": "verify-before-stop.mjs", "timeout": 30 },
      { "event": "PostToolUse", "matcher": "Edit|Write|MultiEdit|NotebookEdit", "file": "verify-before-stop.mjs", "timeout": 30 },
      { "event": "Stop", "matcher": "", "file": "verify-before-stop.mjs", "timeout": 30 },
      { "event": "SessionStart", "matcher": "", "file": "codegraph.mjs", "timeout": 30 },
      { "event": "SessionStart", "matcher": "", "file": "worktree-sweep.mjs", "timeout": 30 }
    ],
    "mcp": [
      {
        "id": "codegraph",
        "detail": "CodeGraph, a prebuilt symbol graph Claude queries instead of grepping; codegraph.mjs builds its index on SessionStart",
        "server": {
          "type": "stdio",
          "command": "npx",
          "args": ["-y", "@colbymchenry/codegraph@1.6.4", "serve", "--mcp", "--no-telemetry"],
          "env": { "CODEGRAPH_TELEMETRY": "0" }
        },
        "contextChars": 8652,
        "contextSource": "codegraph 1.6.4 serve --mcp: initialize instructions (6,718 chars) plus the codegraph_explore tool definition (1,934 chars), measured over stdio on 2026-11-25",
        "ignore": ".codegraph/",
        "allow": ["mcp__codegraph__codegraph_explore"]
      }
    ],
    "skills": [
      { "id": "verify", "path": ".claude/skills/verify/SKILL.md", "template": "claude/skills/verify/SKILL.md", "requires": ["name: verify", "## Feature map"], "placeholder": "TODO(verify)", "detail": "the skill that boots the app, drives the change and checks what it shows, with a feature map" }
    ]
  }
}
