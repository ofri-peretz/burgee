{
  "name": "linegauge",
  "version": "1.0.7",
  "description": "Measures, wraps, truncates and slices styled terminal text, grapheme-correct over Intl.Segmenter, with the same result on a terminal, a pipe or --json. Zero dependencies. Drop-in paths for string-width, wrap-ansi, strip-ansi and slice-ansi.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["./dist/cli.js"],
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./wrap": {
      "types": "./dist/wrap.d.ts",
      "import": "./dist/wrap.js",
      "default": "./dist/wrap.js"
    },
    "./slice": {
      "types": "./dist/slice.d.ts",
      "import": "./dist/slice.js",
      "default": "./dist/slice.js"
    },
    "./truncate": {
      "types": "./dist/truncate.d.ts",
      "import": "./dist/truncate.js",
      "default": "./dist/truncate.js"
    },
    "./widest": {
      "types": "./dist/widest.d.ts",
      "import": "./dist/widest.js",
      "default": "./dist/widest.js"
    },
    "./strip": {
      "types": "./dist/strip.d.ts",
      "import": "./dist/strip.js",
      "default": "./dist/strip.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./schema.json": "./dist/schema.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/schema-to-dist.mjs && node ../../scripts/strip-comments.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage.enabled",
    "lint": "eslint src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/burgee.git",
    "directory": "packages/linegauge"
  },
  "homepage": "https://linegauge.interlace.tools",
  "bugs": {
    "url": "https://github.com/ofri-peretz/burgee/issues"
  },
  "keywords": [
    "cli",
    "terminal",
    "string-width",
    "wrap-ansi",
    "strip-ansi",
    "slice-ansi",
    "truncate",
    "wrap",
    "width",
    "grapheme",
    "ansi",
    "unicode",
    "plugin",
    "plugins",
    "extensible",
    "zero-dependency"
  ],
  "devDependencies": {
    "vitest": "^5.0.1"
  },
  "bin": {
    "linegauge": "./dist/cli.js"
  }
}
