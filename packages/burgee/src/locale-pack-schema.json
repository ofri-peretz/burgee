{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://burgee.interlace.tools/locale-pack-schema.json",
  "title": "burgee locale pack",
  "description": "A plugin that translates burgee's human surfaces — usage errors, hints, help headings, the root's line for agents and the exit-code advice — into one or more languages. Register it with `program.use(pack)`; a run whose locale (the program's `locale` option, then BURGEE_LOCALE, LC_ALL, LC_MESSAGES, LANG) has a pack speaks it. Machine surfaces (--json, --schema, --mcp, --format=agent, error kinds, exit codes) never change. Check one with `burgee check <pack>`. Generated from packages/burgee/src/messages.ts by scripts/locale-pack-schema.ts.",
  "type": "object",
  "required": [
    "name",
    "contract",
    "locales"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "What a refusal names the pack by."
    },
    "contract": {
      "const": 1,
      "description": "The family plugin contract; `definePlugin` from 'burgee/plugin' stamps it."
    },
    "locales": {
      "type": "object",
      "description": "A BCP 47 language tag, as Intl.Locale writes it (de, de-DE, pt-BR), to its messages. A run looks for its own tag first, then the bare language.",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/messages"
      }
    }
  },
  "$defs": {
    "messages": {
      "type": "object",
      "description": "Catalog id to translation. Leave an id out and that message stays in English. An id under `caique.` is caique's prompt chrome, checked by caique; one pack serves both.",
      "patternProperties": {
        "^caique\\.": {}
      },
      "additionalProperties": false,
      "properties": {
        "usage.unknownOption": {
          "description": "unknown option {option}",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:option)\\}|\\{(?!\\w+\\}))*$"
        },
        "usage.unknownCommand": {
          "description": "unknown command \"{command}\"",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:command)\\}|\\{(?!\\w+\\}))*$"
        },
        "usage.unknownShell": {
          "description": "unknown shell \"{shell}\"",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:shell)\\}|\\{(?!\\w+\\}))*$"
        },
        "usage.missingOption": {
          "description": "missing required option --{option}",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:option)\\}|\\{(?!\\w+\\}))*$"
        },
        "usage.missingArgument": {
          "description": "missing required argument \"{argument}\"",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:argument)\\}|\\{(?!\\w+\\}))*$"
        },
        "usage.number": {
          "description": "{option} expects a number, got \"{value}\"",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:option|value)\\}|\\{(?!\\w+\\}))*$"
        },
        "usage.integer": {
          "description": "{option} expects an integer, got {value}",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:option|value)\\}|\\{(?!\\w+\\}))*$"
        },
        "usage.minimum": {
          "description": "{option} must be at least {minimum}, got {value}",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:option|minimum|value)\\}|\\{(?!\\w+\\}))*$"
        },
        "usage.maximum": {
          "description": "{option} must be at most {maximum}, got {value}",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:option|maximum|value)\\}|\\{(?!\\w+\\}))*$"
        },
        "usage.choice": {
          "description": "--{option} must be one of {choices}, got \"{value}\"",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:option|choices|value)\\}|\\{(?!\\w+\\}))*$"
        },
        "usage.schema": {
          "description": "--{option}: {issues}",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:option|issues)\\}|\\{(?!\\w+\\}))*$"
        },
        "usage.exactlyOne": {
          "description": "exactly one of {options} is required",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:options)\\}|\\{(?!\\w+\\}))*$"
        },
        "usage.atLeastOne": {
          "description": "at least one of {options} is required",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:options)\\}|\\{(?!\\w+\\}))*$"
        },
        "usage.atMostOne": {
          "description": "at most one of {options} may be given",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:options)\\}|\\{(?!\\w+\\}))*$"
        },
        "usage.together": {
          "description": "{options} cannot be used together",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:options)\\}|\\{(?!\\w+\\}))*$"
        },
        "usage.requires": {
          "description": "--{option} requires --{other}",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:option|other)\\}|\\{(?!\\w+\\}))*$"
        },
        "usage.notAllowed": {
          "description": "--{option} is not allowed with these values",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:option)\\}|\\{(?!\\w+\\}))*$"
        },
        "usage.timeout": {
          "description": "--timeout takes a duration such as 500ms, 5s or 2m, not \"{value}\"",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:value)\\}|\\{(?!\\w+\\}))*$"
        },
        "usage.color": {
          "description": "--color takes always, never or auto, not \"{value}\"",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:value)\\}|\\{(?!\\w+\\}))*$"
        },
        "usage.noFields": {
          "description": "\"{command}\" declares no fields to list",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:command)\\}|\\{(?!\\w+\\}))*$"
        },
        "usage.unknownField": {
          "description": "unknown field {fields}",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:fields)\\}|\\{(?!\\w+\\}))*$"
        },
        "usage.unknownFields": {
          "description": "unknown fields {fields}",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:fields)\\}|\\{(?!\\w+\\}))*$"
        },
        "usage.noSchemaField": {
          "description": "{at} has no field \"{field}\"",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:at|field)\\}|\\{(?!\\w+\\}))*$"
        },
        "usage.fieldOne": {
          "description": "--field drills into one command",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "usage.stdinOnce": {
          "description": "\"-\" was given for {count} file arguments, and standard input can be read once — a string, or one string per plural form Intl.PluralRules selects for the locale",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[^{]|\\{(?:count)\\}|\\{(?!\\w+\\}))*$"
            },
            {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "zero",
                  "one",
                  "two",
                  "few",
                  "many",
                  "other"
                ]
              },
              "required": [
                "other"
              ],
              "additionalProperties": {
                "type": "string",
                "pattern": "^(?:[^{]|\\{(?:count)\\}|\\{(?!\\w+\\}))*$"
              }
            }
          ]
        },
        "config.noVersion": {
          "description": "no version declared",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "timeout.passed": {
          "description": "timed out after {ms} ms",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:ms)\\}|\\{(?!\\w+\\}))*$"
        },
        "hint.runHelp": {
          "description": "run --help to see the available options",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "hint.runSchema": {
          "description": "run --schema for every command and option as JSON, in one call; --explain <option> says where a value came from",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "hint.didYouMean": {
          "description": "did you mean {suggestion}?",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:suggestion)\\}|\\{(?!\\w+\\}))*$"
        },
        "hint.didYouMeanOneOf": {
          "description": "did you mean one of {suggestions}?",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:suggestions)\\}|\\{(?!\\w+\\}))*$"
        },
        "hint.singleDash": {
          "description": "did you mean --{option}? a single dash introduces one-letter options",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:option)\\}|\\{(?!\\w+\\}))*$"
        },
        "hint.textDefault": {
          "description": "text is the default",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "hint.passOption": {
          "description": "pass --{option} <value>",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:option)\\}|\\{(?!\\w+\\}))*$"
        },
        "hint.passFlag": {
          "description": "pass --{option}",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:option)\\}|\\{(?!\\w+\\}))*$"
        },
        "hint.passNumber": {
          "description": "pass {option} <number>",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:option)\\}|\\{(?!\\w+\\}))*$"
        },
        "hint.passValue": {
          "description": "pass {option} {value}",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:option|value)\\}|\\{(?!\\w+\\}))*$"
        },
        "hint.passChoice": {
          "description": "pass --{option} {value}",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:option|value)\\}|\\{(?!\\w+\\}))*$"
        },
        "hint.check": {
          "description": "check --{option}",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:option)\\}|\\{(?!\\w+\\}))*$"
        },
        "hint.passOne": {
          "description": "pass one of them",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "hint.dropAllButOne": {
          "description": "drop all but one of {options}",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:options)\\}|\\{(?!\\w+\\}))*$"
        },
        "hint.dropOne": {
          "description": "drop one of them",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "hint.checkValues": {
          "description": "check the values --{option} is declared to require",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:option)\\}|\\{(?!\\w+\\}))*$"
        },
        "hint.timeout": {
          "description": "a bare number is milliseconds; it must be above 0",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "hint.noColor": {
          "description": "pass --no-color to turn colour off",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "hint.wholeResult": {
          "description": "run \"{command} --json\" to see its whole result",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:command)\\}|\\{(?!\\w+\\}))*$"
        },
        "hint.validFields": {
          "description": "valid fields: {fields}",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:fields)\\}|\\{(?!\\w+\\}))*$"
        },
        "hint.schemaFields": {
          "description": "fields here: {fields}",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:fields)\\}|\\{(?!\\w+\\}))*$"
        },
        "hint.nameCommand": {
          "description": "name the command first: --schema <command> --field <path>",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "hint.stdinOnce": {
          "description": "pass a path for all but one of them",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "hint.largerTimeout": {
          "description": "run it again with a larger --timeout",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "hint.declareVersion": {
          "description": "pass version to defineProgram, or set \"version\" in the owning package.json",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "usage.options": {
          "description": "options:",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "usage.commands": {
          "description": "commands:",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "usage.more": {
          "description": "  … the rest: {command}",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:command)\\}|\\{(?!\\w+\\}))*$"
        },
        "help.usage": {
          "description": "Usage:",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "help.arguments": {
          "description": "Arguments:",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "help.options": {
          "description": "Options:",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "help.globalOptions": {
          "description": "Global options:",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "help.commands": {
          "description": "Commands:",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "help.examples": {
          "description": "Examples:",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "help.environment": {
          "description": "Environment:",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "help.exitCodes": {
          "description": "Exit codes:",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "help.json": {
          "description": "machine-readable output",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "help.help": {
          "description": "show this help",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "help.schema": {
          "description": "the program as data",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "help.explain": {
          "description": "where an option's value came from",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "help.color": {
          "description": "always, never or auto (default: auto); NO_COLOR is honoured",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "help.noColor": {
          "description": "the same as --color=never",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "help.quiet": {
          "description": "silence progress and hints; data and errors still print",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "help.timeout": {
          "description": "end the run after this long, exit {code}: 500ms, 5s, 2m",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?:code)\\}|\\{(?!\\w+\\}))*$"
        },
        "help.completion": {
          "description": "Print a shell completion script: bash, zsh, fish, pwsh or fig",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "help.completionShell": {
          "description": "bash, zsh, fish, pwsh or fig",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "help.forAgents": {
          "description": "For agents: --schema prints every command, option, default and env var as JSON, in one call. --json prints one envelope on stdout, and --explain <option> says where a value came from.",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "exit.ok": {
          "description": "the command completed",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "exit.runtime": {
          "description": "it ran and failed; read the message",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "exit.usage": {
          "description": "bad arguments or an unknown command; rewrite the command",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "exit.config": {
          "description": "the config or environment did not load; fix it, not the command",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "exit.cancelled": {
          "description": "cancelled, or a decision is needed; decide, then run a next command",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "exit.auth": {
          "description": "a credential is missing or refused; log in and run it again",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "exit.timeout": {
          "description": "the --timeout deadline passed; run it again with more time",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        },
        "exit.sigint": {
          "description": "interrupted; stop",
          "type": "string",
          "pattern": "^(?:[^{]|\\{(?!\\w+\\}))*$"
        }
      }
    }
  }
}
