exports[`completions are generated from the manifest (D2) and pinned (D4) > fish script is deterministic and mentions every visible command and option 1`] = `
"# demo completion for fish, generated by burgee — never runs demo on TAB.
# Install: demo completion fish > ~/.config/fish/completions/demo.fish
complete -c demo -n '__fish_use_subcommand' -f -a greet -d 'Greet someone'
complete -c demo -n '__fish_use_subcommand' -f -a config -d 'Read configuration'
complete -c demo -n '__fish_use_subcommand' -l json -d 'machine-readable output'
complete -c demo -n '__fish_use_subcommand' -l help -d 'show this help'
complete -c demo -n '__fish_use_subcommand' -l schema -d 'the program as data'
complete -c demo -n '__fish_use_subcommand' -l mcp -d 'serve the program as MCP tools'
complete -c demo -n '__fish_seen_subcommand_from greet' -s s -l shout -d 'uppercase'
complete -c demo -n '__fish_seen_subcommand_from greet' -l greeting -r -f -a 'Hello Hi' -d 'the greeting word'
complete -c demo -n '__fish_seen_subcommand_from greet' -l json -d 'machine-readable output'
complete -c demo -n '__fish_seen_subcommand_from greet' -l help -d 'show this help'
complete -c demo -n '__fish_seen_subcommand_from config' -f -a get -d 'Print one value'
complete -c demo -n '__fish_seen_subcommand_from config' -l json -d 'machine-readable output'
complete -c demo -n '__fish_seen_subcommand_from config' -l help -d 'show this help'
complete -c demo -n '__fish_seen_subcommand_from config; and __fish_seen_subcommand_from get' -l raw -d ''
complete -c demo -n '__fish_seen_subcommand_from config; and __fish_seen_subcommand_from get' -l json -d 'machine-readable output'
complete -c demo -n '__fish_seen_subcommand_from config; and __fish_seen_subcommand_from get' -l help -d 'show this help'
"
`;

exports[`completions are generated from the manifest (D2) and pinned (D4) > pwsh script is deterministic and mentions every visible command and option 1`] = `
"# demo completion for PowerShell, generated by burgee — never runs demo on TAB.
# Install: demo completion pwsh > demo-completion.ps1, then dot-source it from $PROFILE
Register-ArgumentCompleter -Native -CommandName 'demo' -ScriptBlock {
  param($wordToComplete, $commandAst, $cursorPosition)
  $table = @{
    '' = @{ Items = @(@('greet', 'Command', 'Greet someone'), @('config', 'Command', 'Read configuration'), @('--json', 'ParameterName', 'machine-readable output'), @('--help', 'ParameterName', 'show this help'), @('--schema', 'ParameterName', 'the program as data'), @('--mcp', 'ParameterName', 'serve the program as MCP tools')); Values = @{  } }
    'greet' = @{ Items = @(@('-s', 'ParameterName', 'uppercase'), @('--shout', 'ParameterName', 'uppercase'), @('--greeting', 'ParameterName', 'the greeting word'), @('--json', 'ParameterName', 'machine-readable output'), @('--help', 'ParameterName', 'show this help')); Values = @{ '--greeting' = @('Hello', 'Hi') } }
    'config' = @{ Items = @(@('get', 'Command', 'Print one value'), @('--json', 'ParameterName', 'machine-readable output'), @('--help', 'ParameterName', 'show this help')); Values = @{  } }
    'config get' = @{ Items = @(@('--raw', 'ParameterName', ''), @('--json', 'ParameterName', 'machine-readable output'), @('--help', 'ParameterName', 'show this help')); Values = @{  } }
  }
  $words = @($commandAst.CommandElements | ForEach-Object { $_.Extent.Text } | Select-Object -Skip 1)
  if ($wordToComplete -ne '' -and $words.Count -gt 0) { $words = $words[0..($words.Count - 2)] }
  $path = ''
  foreach ($w in $words) {
    if ($w -like '-*') { continue }
    $candidate = if ($path -eq '') { $w } else { "$path $w" }
    if ($table.ContainsKey($candidate)) { $path = $candidate }
  }
  $entry = $table[$path]
  $prev = if ($words.Count -gt 0) { $words[$words.Count - 1] } else { '' }
  if ($entry.Values.ContainsKey($prev)) {
    $entry.Values[$prev] | Where-Object { $_ -like "$wordToComplete*" } | ForEach-Object { [System.Management.Automation.CompletionResult]::new($_, $_, 'ParameterValue', $_) }
    return
  }
  $entry.Items | Where-Object { $_[0] -like "$wordToComplete*" } | ForEach-Object { [System.Management.Automation.CompletionResult]::new($_[0], $_[0], $_[1], $(if ($_[2] -eq '') { $_[0] } else { $_[2] })) }
}
"
`;

exports[`completions are generated from the manifest (D2) and pinned (D4) > zsh script is deterministic and mentions every visible command and option 1`] = `
"#compdef demo
# demo completion for zsh, generated by burgee — never runs demo on TAB.
# Install: demo completion zsh > "\${fpath[1]}/_demo" && compinit
_demo() {
  local context state state_descr line
  typeset -A opt_args
  _arguments -s -C '--json[machine-readable output]' '--help[show this help]' '--schema[the program as data]' '--mcp[serve the program as MCP tools]' '1: :->command' '*:: :->args'
  case $state in
    command) _values 'command' 'greet[Greet someone]' 'config[Read configuration]' ;;
    args) case $line[1] in
      greet) _demo_greet ;;
      config) _demo_config ;;
    esac ;;
  esac
}
_demo_greet() {
  _arguments -s '-s[uppercase]' '--shout[uppercase]' '--greeting[the greeting word]:greeting:(Hello Hi)' '--json[machine-readable output]' '--help[show this help]' '*: :_files'
}
_demo_config() {
  local context state state_descr line
  typeset -A opt_args
  _arguments -s -C '--json[machine-readable output]' '--help[show this help]' '1: :->command' '*:: :->args'
  case $state in
    command) _values 'command' 'get[Print one value]' ;;
    args) case $line[1] in
      get) _demo_config_get ;;
    esac ;;
  esac
}
_demo_config_get() {
  _arguments -s '--raw[]' '--json[machine-readable output]' '--help[show this help]' '*: :_files'
}
if [[ $zsh_eval_context[-1] == loadautofunc ]]; then _demo "$@"; else compdef _demo demo; fi
"
`;
