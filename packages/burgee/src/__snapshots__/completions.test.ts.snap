exports[`completions are generated from the manifest (D2) and pinned (D4) > bash script is deterministic and mentions every visible command and option 1`] = `
"# demo completion for bash, generated by burgee — never runs demo on TAB.
# Install: demo completion bash > ~/.local/share/bash-completion/completions/demo
_demo_main() {
  local cur prev words cword
  _get_comp_words_by_ref -n : cur prev words cword 2>/dev/null || { cur="\${COMP_WORDS[COMP_CWORD]}"; prev="\${COMP_WORDS[COMP_CWORD-1]}"; words=("\${COMP_WORDS[@]}"); cword=$COMP_CWORD; }
  _demo() {
    case "$prev" in
      *) ;;
    esac
    if [[ "$cur" == -* ]]; then COMPREPLY=($(compgen -W '--json --help --schema --mcp' -- "$cur")); return; fi
    COMPREPLY=($(compgen -W 'greet config' -- "$cur"))
  }
  _demo_greet() {
    case "$prev" in
      --greeting) COMPREPLY=($(compgen -W 'Hello Hi' -- "$cur")); return ;;
      *) ;;
    esac
    if [[ "$cur" == -* ]]; then COMPREPLY=($(compgen -W '-s --shout --greeting --json --help' -- "$cur")); return; fi
    COMPREPLY=($(compgen -W '' -- "$cur"))
  }
  _demo_config() {
    case "$prev" in
      *) ;;
    esac
    if [[ "$cur" == -* ]]; then COMPREPLY=($(compgen -W '--json --help' -- "$cur")); return; fi
    COMPREPLY=($(compgen -W 'get' -- "$cur"))
  }
  _demo_config_get() {
    case "$prev" in
      *) ;;
    esac
    if [[ "$cur" == -* ]]; then COMPREPLY=($(compgen -W '--raw --json --help' -- "$cur")); return; fi
    COMPREPLY=($(compgen -W '' -- "$cur"))
  }
  # The deepest command named by the words before the cursor decides what to offer.
  local path="" i
  for ((i = 1; i < cword; i++)); do
    case "\${words[i]}" in -*) continue ;; esac
    case "\${path:+$path }\${words[i]}" in
      'greet') path="\${path:+$path }\${words[i]}" ;;
      'config') path="\${path:+$path }\${words[i]}" ;;
      'config get') path="\${path:+$path }\${words[i]}" ;;
    esac
  done
  case "$path" in
      'greet') _demo_greet; return ;;
      'config') _demo_config; return ;;
      'config get') _demo_config_get; return ;;
      *) _demo ;;
  esac
}
complete -F _demo_main demo
"
`;

