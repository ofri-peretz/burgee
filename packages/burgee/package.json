{
  "name": "burgee",
  "version": "0.2.0",
  "description": "An agent-native CLI framework, drop-in compatible with commander and yargs. One declaration; help, --json, --schema, --mcp and completions all projected from it.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./brand": {
      "types": "./dist/brand.d.ts",
      "import": "./dist/brand.js",
      "default": "./dist/brand.js"
    },
    "./contrast": {
      "types": "./dist/contrast.d.ts",
      "import": "./dist/contrast.js",
      "default": "./dist/contrast.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./commander": {
      "types": "./dist/commander.d.ts",
      "import": "./dist/commander.js",
      "default": "./dist/commander.js"
    },
    "./completions": {
      "types": "./dist/completions.d.ts",
      "import": "./dist/completions.js",
      "default": "./dist/completions.js"
    },
    "./yargs": {
      "types": "./dist/yargs.d.ts",
      "import": "./dist/yargs.js",
      "default": "./dist/yargs.js"
    },
    "./yargs/helpers": {
      "types": "./dist/yargs-helpers.d.ts",
      "import": "./dist/yargs-helpers.js",
      "default": "./dist/yargs-helpers.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.test.*",
    "locales"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/strip-comments.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/burgee.git",
    "directory": "packages/burgee"
  },
  "homepage": "https://github.com/ofri-peretz/burgee#readme",
  "bugs": {
    "url": "https://github.com/ofri-peretz/burgee/issues"
  },
  "keywords": [
    "cli",
    "command-line",
    "argv",
    "commander",
    "yargs",
    "mcp",
    "agent",
    "framework"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "vitest": "^4.0.0"
  },
  "bin": {
    "burgee": "./dist/cli.js"
  }
}
