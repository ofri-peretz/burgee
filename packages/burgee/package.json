{
  "name": "burgee",
  "version": "0.11.1",
  "description": "An agent-native CLI framework, drop-in compatible with commander and yargs. One declaration; help, --json, --schema, --mcp and completions all projected from it.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/cli.js"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema.json": "./dist/schema.json",
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./help": {
      "types": "./dist/help-entry.d.ts",
      "import": "./dist/help-entry.js",
      "default": "./dist/help-entry.js"
    },
    "./mcp": {
      "types": "./dist/mcp-entry.d.ts",
      "import": "./dist/mcp-entry.js",
      "default": "./dist/mcp-entry.js"
    },
    "./schema": {
      "types": "./dist/schema-entry.d.ts",
      "import": "./dist/schema-entry.js",
      "default": "./dist/schema-entry.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./brand": {
      "types": "./dist/brand.d.ts",
      "import": "./dist/brand.js",
      "default": "./dist/brand.js"
    },
    "./contrast": {
      "types": "./dist/contrast.d.ts",
      "import": "./dist/contrast.js",
      "default": "./dist/contrast.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./commander": {
      "types": "./dist/commander.d.ts",
      "import": "./dist/commander.js",
      "default": "./dist/commander.js"
    },
    "./meow": {
      "types": "./dist/meow.d.ts",
      "import": "./dist/meow.js",
      "default": "./dist/meow.js"
    },
    "./completions": {
      "types": "./dist/completions.d.ts",
      "import": "./dist/completions.js",
      "default": "./dist/completions.js"
    },
    "./yargs": {
      "types": "./dist/yargs.d.ts",
      "import": "./dist/yargs.js",
      "default": "./dist/yargs.js"
    },
    "./yargs/helpers": {
      "types": "./dist/yargs-helpers.d.ts",
      "import": "./dist/yargs-helpers.js",
      "default": "./dist/yargs-helpers.js"
    },
    "./yargs/parser": {
      "types": "./dist/yargs-parser.d.ts",
      "import": "./dist/yargs-parser.js",
      "default": "./dist/yargs-parser.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.test.*",
    "locales"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/schema-to-dist.mjs && node ../../scripts/strip-comments.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage.enabled",
    "lint": "eslint src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/burgee.git",
    "directory": "packages/burgee"
  },
  "homepage": "https://burgee.interlace.tools/docs/packages/burgee",
  "bugs": {
    "url": "https://github.com/ofri-peretz/burgee/issues"
  },
  "keywords": [
    "cli",
    "command-line",
    "argv",
    "commander",
    "yargs",
    "mcp",
    "agent",
    "framework",
    "plugin",
    "plugins",
    "extensible",
    "cli-framework",
    "argument-parser",
    "subcommands",
    "json-schema",
    "mcp-server",
    "model-context-protocol",
    "ai-agent",
    "llm",
    "shell-completion",
    "typescript",
    "no-external-dependencies",
    "commander-alternative",
    "yargs-alternative"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "bellpull": "^0.3.1",
    "closeout": "^0.5.1",
    "linegauge": "^0.5.1",
    "roundel": "^0.5.1",
    "seniority": "^0.5.1"
  },
  "devDependencies": {
    "vitest": "^5.0.1"
  },
  "bin": {
    "burgee": "./dist/cli.js"
  }
}
