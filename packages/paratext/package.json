{
  "name": "paratext",
  "version": "0.5.0",
  "description": "Everything around your terminal output that is not the output: hyperlinks, images, window title, clipboard, notifications and the bell \u2014 each with a static fallback for terminals that cannot do it. Covers the OSC half of ansi-escapes, terminal-link and term-img; a drop-in path is not claimed until the compat oracle grades one. Zero dependencies.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./link": {
      "types": "./dist/link.d.ts",
      "import": "./dist/link.js",
      "default": "./dist/link.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./schema.json": "./dist/schema.json",
    "./term-img": {
      "types": "./dist/term-img.d.ts",
      "import": "./dist/term-img.js",
      "default": "./dist/term-img.js"
    },
    "./terminal-link": {
      "types": "./dist/terminal-link.d.ts",
      "import": "./dist/terminal-link.js",
      "default": "./dist/terminal-link.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/schema-to-dist.mjs && node ../../scripts/strip-comments.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "coverage": "vitest run --coverage.enabled"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/burgee.git",
    "directory": "packages/paratext"
  },
  "homepage": "https://github.com/ofri-peretz/burgee/tree/main/packages/paratext#readme",
  "bugs": {
    "url": "https://github.com/ofri-peretz/burgee/issues"
  },
  "keywords": [
    "cli",
    "terminal",
    "ansi",
    "osc",
    "hyperlink",
    "terminal-link",
    "ansi-escapes",
    "clipboard",
    "notification",
    "image",
    "title",
    "bell",
    "plugin",
    "plugins",
    "extensible"
  ],
  "devDependencies": {
    "vitest": "^5.0.1"
  },
  "bin": {
    "paratext": "./dist/cli.js"
  }
}
