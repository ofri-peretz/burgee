{
  "name": "cli",
  "version": "0.0.0",
  "description": "burgee: an agent-native CLI framework, drop-in compatible with commander and yargs, its compatibility oracle, and the documentation site.",
  "private": true,
  "workspaces": [
    "apps/*",
    "benchmarks",
    "packages/*",
    "examples/*"
  ],
  "packageManager": "npm@11.6.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/burgee.git"
  },
  "bugs": {
    "url": "https://github.com/ofri-peretz/burgee/issues"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "[ -d .git ] && lefthook install || true",
    "build": "turbo run build",
    "coverage": "turbo run coverage",
    "bench": "tsx benchmarks/run.ts",
    "bench:page": "tsx scripts/bench-page.ts",
    "readme:gates": "tsx scripts/readme-gates.ts",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --config vitest.root.config.ts && turbo run test",
    "lint": "eslint . --max-warnings 0 && npm run lint:workflows && npm run lint:md && npm run brand:check && npm run check:artifacts && turbo run lint",
    "ci:local": "lefthook run pre-push --all-files --force",
    "research:refresh": "scripts/fetch-competitor-issues.sh",
    "rank:dependents": "tsx scripts/rank-dependents.ts",
    "changeset": "changeset",
    "changeset:status": "env -u GIT_DIR changeset status --since=origin/main",
    "changeset:version": "changeset version && npx tsx scripts/sync-doc-versions.ts && npx tsx scripts/sync-package-docs.ts && npx -y npm@11.16.0 install --package-lock-only --ignore-scripts",
    "lint:workflows": "tsx scripts/lint-workflows.ts",
    "lint:md": "markdownlint-cli2 '**/*.md' '.sdlc/**/*.md' '#node_modules' '#**/node_modules' '#**/dist' '#**/.next' '#.sdlc/research/issues' '#packages/compat-oracle/vendor-diff.md' '#packages/compat-oracle/vendor'",
    "brand": "node scripts/brand.mts",
    "brand:check": "node scripts/brand.mts --check",
    "release": "gh workflow run release.yml --ref main",
    "release:dry-run": "gh workflow run release.yml --ref main -f dry-run=true",
    "control-bands": "tsx scripts/control-bands.ts",
    "evals": "tsx scripts/run-evals.ts",
    "evals:config": "tsx scripts/run-evals.ts --config",
    "compat": "npm run build -w compat-oracle && node packages/compat-oracle/dist/bin.js",
    "compat:page": "tsx scripts/compat-page.ts",
    "gallery:page": "tsx scripts/gallery-page.ts",
    "schema:sync": "node scripts/schema-sync.mjs",
    "check:artifacts": "tsx scripts/check-published-artifacts.ts",
    "mark-lab": "node scripts/mark-lab.mts",
    "decisions": "tsx scripts/decisions.ts",
    "weight:page": "tsx scripts/subpath-weight.ts",
    "weight:converge": "node scripts/weight-converge.mjs",
    "plugins:page": "tsx scripts/plugins-page.ts"
  },
  "overrides": {
    "smol-toml": "^1.7.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@colors/colors": "1.6.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.2",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "^5.0.1",
    "ava": "^8.0.1",
    "benchmarks": "*",
    "boxen": "^9.0.0",
    "burgee": "*",
    "chai": "^6.2.2",
    "chalk": "^6.0.0",
    "cli-boxes": "^4.0.1",
    "cli-spinners": "^3.2.0",
    "cli-table": "0.3.11",
    "cli-table3": "^0.6.5",
    "cli-truncate": "^6.1.1",
    "commander": "^15.0.0",
    "compat-oracle": "*",
    "cpr": "^3.0.1",
    "cross-spawn": "^7.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-browser-security": "^2.1.5",
    "eslint-plugin-conventions": "^6.0.2",
    "eslint-plugin-import-next": "^2.8.2",
    "eslint-plugin-maintainability": "^3.2.10",
    "eslint-plugin-modernization": "^3.1.4",
    "eslint-plugin-modularity": "^2.0.4",
    "eslint-plugin-node-security": "^5.6.1",
    "eslint-plugin-operability": "^4.1.4",
    "eslint-plugin-react-a11y": "^2.1.5",
    "eslint-plugin-react-features": "^1.7.6",
    "eslint-plugin-reliability": "^4.1.9",
    "eslint-plugin-secure-coding": "^5.4.5",
    "execa": "^10.0.0",
    "fast-check": "^4.10.2",
    "flagstaff": "*",
    "get-stream": "^9.0.1",
    "hashish": "0.0.4",
    "js-yaml": "^5.4.2",
    "lefthook": "^2.1.14",
    "log-update": "8.0.0",
    "markdownlint-cli2": "^0.23.3",
    "mocha": "^12.0.1",
    "ora": "9.4.1",
    "prettier": "^3.9.8",
    "roundel": "workspace:*",
    "semver": "^7.7.0",
    "slice-ansi": "^7.1.0",
    "string-width": "^8.2.2",
    "strip-ansi": "^7.1.2",
    "supports-hyperlinks": "4.5.0",
    "terminal-link": "5.0.0",
    "terminal.js": "^1.0.11",
    "tsx": "^4.23.15",
    "turbo": "^2.11.2",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1",
    "wcwidth": "^1.0.1",
    "which": "^2.0.2",
    "wrap-ansi": "^10.0.1",
    "yargs": "^18.0.0",
    "yargs-parser": "^22.0.0",
    "yargs-test-extends": "^1.0.1"
  }
}
