{
  "name": "cli",
  "version": "0.0.0",
  "description": "burgee: an agent-native CLI framework, drop-in compatible with commander and yargs, its compatibility oracle, and the documentation site.",
  "private": true,
  "workspaces": [
    "apps/*",
    "benchmarks",
    "packages/*",
    "examples/*",
    "!examples/chat-cli-ink",
    "!examples/dashboard-ink",
    "!examples/ink-ecosystem"
  ],
  "packageManager": "npm@11.16.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/burgee.git"
  },
  "bugs": {
    "url": "https://github.com/ofri-peretz/burgee/issues"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "[ -d .git ] && lefthook install || true",
    "build": "turbo run build",
    "coverage": "turbo run coverage",
    "bench": "tsx benchmarks/run.ts",
    "agent-cost:row": "tsx scripts/agent-cost-row.ts",
    "bench:page": "tsx scripts/bench-page.ts",
    "callers:page": "tsx scripts/callers-page.ts",
    "readme:gates": "tsx scripts/readme-gates.ts",
    "ratchets:propose": "tsx scripts/claim-ratchets.ts",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --config vitest.root.config.ts && turbo run test",
    "lint": "eslint . --max-warnings 0 && npm run lint:workflows && npm run lint:md && npm run brand:check && npm run check:artifacts && turbo run lint",
    "ci:local": "lefthook run pre-push --all-files --force",
    "research:refresh": "scripts/fetch-competitor-issues.sh",
    "rank:dependents": "tsx scripts/rank-dependents.ts",
    "changeset": "changeset",
    "changeset:status": "env -u GIT_DIR changeset status --since=origin/main",
    "changeset:version": "changeset version && node packages/oxmutate/scripts/sync-platform-versions.mjs && npx tsx scripts/sync-doc-versions.ts && npx tsx scripts/sync-package-docs.ts && npx -y npm@11.16.0 install --package-lock-only --ignore-scripts && npm run weight:converge",
    "lint:workflows": "tsx scripts/lint-workflows.ts",
    "lint:md": "markdownlint-cli2 '**/*.md' '.sdlc/**/*.md' '#node_modules' '#**/node_modules' '#**/dist' '#**/.next' '#.sdlc/research/issues' '#packages/compat-oracle/vendor-diff.md' '#packages/compat-oracle/vendor'",
    "brand": "node scripts/brand.mts",
    "brand:check": "node scripts/brand.mts --check",
    "release": "gh workflow run release.yml --ref main",
    "release:dry-run": "gh workflow run release.yml --ref main -f dry-run=true",
    "control-bands": "tsx scripts/control-bands.ts",
    "evals": "tsx scripts/run-evals.ts",
    "evals:config": "tsx scripts/run-evals.ts --config",
    "compat": "npm run build -w compat-oracle && node packages/compat-oracle/dist/bin.js",
    "compat:page": "tsx scripts/compat-page.ts",
    "compat:mutation": "npm run compat:mutation -w oxmutate",
    "mutation:changed": "bash scripts/mutation-changed.sh",
    "mutation:weekly": "bash scripts/mutation-weekly.sh",
    "gallery:page": "tsx scripts/gallery-page.ts",
    "schema:sync": "node scripts/schema-sync.mjs",
    "check:artifacts": "tsx scripts/check-published-artifacts.ts",
    "mark-lab": "node scripts/mark-lab.mts",
    "decisions": "tsx scripts/decisions.ts",
    "ledger": "tsx scripts/ledgers.ts",
    "weight:page": "tsx scripts/subpath-weight.ts",
    "weight:converge": "node scripts/weight-converge.mjs",
    "plugins:page": "tsx scripts/plugins-page.ts",
    "layers:page": "tsx scripts/layers-page.ts",
    "truth-table:page": "tsx scripts/truth-table-page.ts",
    "check:osv": "tsx scripts/osv-check.ts",
    "install-graph": "tsx scripts/install-graph.ts"
  },
  "overrides": {
    "js-yaml@3": {
      "argparse": "^2.0.1"
    },
    "katex": "^0.18.2",
    "markdown-it": "^15.0.2",
    "smol-toml": "^1.9.0",
    "qs": "6.16.1",
    "re2js": "2.8.7",
    "glob@^13": "^14.0.2",
    "minimatch@^10": "^11.0.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@colors/colors": "1.6.1",
    "@commander-js/extra-typings": "15.1.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.2",
    "@inquirer/prompts": "8.8.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "^5.1.0",
    "ava": "^8.4.0",
    "benchmarks": "*",
    "boxen": "^9.0.0",
    "burgee": "*",
    "chai": "^6.2.2",
    "chalk": "^6.0.1",
    "cli-boxes": "^4.0.1",
    "cli-spinners": "^3.2.0",
    "cli-table": "0.3.11",
    "cli-table3": "^0.6.5",
    "cli-truncate": "^6.2.0",
    "colorette": "2.0.20",
    "commander": "^15.1.0",
    "compat-oracle": "*",
    "cpr": "^3.0.1",
    "cross-spawn": "^7.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-anthropic-security": "^1.1.0",
    "eslint-plugin-browser-security": "^2.2.0",
    "eslint-plugin-conventions": "^6.1.0",
    "eslint-plugin-drizzle-security": "^1.1.0",
    "eslint-plugin-express-security": "^3.3.0",
    "eslint-plugin-gemini-security": "^1.1.0",
    "eslint-plugin-import-next": "^2.9.1",
    "eslint-plugin-jwt-security": "^3.6.0",
    "eslint-plugin-knex-security": "^1.1.0",
    "eslint-plugin-lambda-security": "^2.2.0",
    "eslint-plugin-maintainability": "^3.3.0",
    "eslint-plugin-mcp-sdk-security": "^1.1.0",
    "eslint-plugin-modernization": "^3.2.0",
    "eslint-plugin-modularity": "^2.6.0",
    "eslint-plugin-mongodb-security": "^9.2.0",
    "eslint-plugin-mysql-security": "^1.1.0",
    "eslint-plugin-nestjs-security": "^3.2.0",
    "eslint-plugin-node-security": "^5.8.0",
    "eslint-plugin-openai-security": "^1.1.0",
    "eslint-plugin-operability": "^4.2.0",
    "eslint-plugin-postgresql-security": "^2.7.0",
    "eslint-plugin-prisma-security": "^1.1.0",
    "eslint-plugin-react-a11y": "^2.6.0",
    "eslint-plugin-react-features": "^1.8.0",
    "eslint-plugin-reliability": "^4.2.0",
    "eslint-plugin-secure-coding": "^5.5.0",
    "eslint-plugin-sequelize-security": "^1.1.0",
    "eslint-plugin-sqlite-security": "^1.1.0",
    "eslint-plugin-supabase-security": "^1.1.0",
    "eslint-plugin-typeorm-security": "^1.1.0",
    "eslint-plugin-vercel-ai-security": "^2.4.0",
    "execa": "^10.2.1",
    "fast-check": "^4.10.2",
    "flagstaff": "*",
    "get-east-asian-width": "1.7.0",
    "get-stream": "^9.0.1",
    "hashish": "0.0.4",
    "js-yaml": "^5.4.2",
    "kleur": "4.1.5",
    "lefthook": "^2.2.2",
    "log-update": "8.0.0",
    "markdownlint-cli2": "^0.24.0",
    "meow": "14.1.0",
    "mocha": "^12.0.1",
    "ora": "10.0.0",
    "prettier": "^3.9.10",
    "roundel": "workspace:*",
    "semver": "^7.8.6",
    "slice-ansi": "^10.0.1",
    "string-width": "^8.3.0",
    "strip-ansi": "^7.1.2",
    "supports-color": "11.0.0",
    "supports-hyperlinks": "4.6.0",
    "terminal-link": "5.0.0",
    "terminal.js": "^1.0.11",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-5.9": "npm:typescript@~5.9.3",
    "typescript-7.0": "npm:typescript@~7.0.2",
    "vitest": "^5.0.1",
    "wcwidth": "^1.0.1",
    "which": "^2.0.2",
    "wrap-ansi": "^10.0.2",
    "yargs": "^18.2.0",
    "yargs-parser": "^22.0.0",
    "yargs-test-extends": "^1.0.1",
    "yoctocolors": "2.2.0"
  }
}
