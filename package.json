{
  "name": "cli",
  "version": "0.0.0",
  "description": "burgee: an agent-native CLI framework, drop-in compatible with commander and yargs, its compatibility oracle, and the documentation site.",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "packageManager": "npm@11.6.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/burgee.git"
  },
  "bugs": {
    "url": "https://github.com/ofri-peretz/burgee/issues"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "[ -d .git ] && lefthook install || true",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --config vitest.root.config.ts && turbo run test",
    "lint": "eslint . --max-warnings 0 && npm run lint:workflows && npm run lint:md && npm run brand:check && turbo run lint",
    "ci:local": "lefthook run pre-push --all-files --force",
    "research:refresh": "scripts/fetch-competitor-issues.sh",
    "rank:dependents": "tsx scripts/rank-dependents.ts",
    "changeset": "changeset",
    "changeset:status": "env -u GIT_DIR changeset status --since=origin/main",
    "changeset:version": "changeset version && npm install --package-lock-only --ignore-scripts",
    "lint:workflows": "tsx scripts/lint-workflows.ts",
    "lint:md": "markdownlint-cli2 '**/*.md' '.sdlc/**/*.md' '#node_modules' '#**/node_modules' '#**/dist' '#**/.next' '#.sdlc/research/issues' '#packages/compat-oracle/vendor-diff.md' '#packages/compat-oracle/vendor'",
    "brand": "node scripts/brand.mts",
    "brand:check": "node scripts/brand.mts --check",
    "release": "gh workflow run release.yml --ref main",
    "release:dry-run": "gh workflow run release.yml --ref main -f dry-run=true",
    "bench": "tsx benchmarks/bench.ts",
    "bench:record": "npm run build -w demo-cli-burgee -w demo-cli-commander -w demo-cli-yargs && tsx benchmarks/bench.ts --record",
    "control-bands": "tsx scripts/control-bands.ts",
    "evals": "tsx scripts/run-evals.ts",
    "evals:config": "tsx scripts/run-evals.ts --config",
    "compat": "npm run build -w compat-oracle && node packages/compat-oracle/dist/bin.js",
    "compat:page": "tsx scripts/compat-page.ts",
    "gallery:page": "tsx scripts/gallery-page.ts",
    "schema:sync": "node scripts/schema-sync.mjs",
    "check:artifacts": "tsx scripts/check-published-artifacts.ts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "burgee": "*",
    "cli-spinners": "^3.2.0",
    "compat-oracle": "*",
    "eslint": "^10.10.0",
    "eslint-plugin-conventions": "^5.3.2",
    "eslint-plugin-import-next": "^2.7.5",
    "eslint-plugin-maintainability": "^3.0.3",
    "eslint-plugin-modernization": "^3.1.3",
    "eslint-plugin-modularity": "^2.0.4",
    "eslint-plugin-node-security": "^5.4.4",
    "eslint-plugin-operability": "^4.1.1",
    "eslint-plugin-react-a11y": "^2.1.5",
    "eslint-plugin-react-features": "^1.1.4",
    "eslint-plugin-reliability": "^4.1.3",
    "eslint-plugin-secure-coding": "^5.3.3",
    "flagstaff": "*",
    "js-yaml": "^5.4.1",
    "lefthook": "^2.1.12",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.4.0",
    "semver": "^7.7.0",
    "tsx": "^4.19.0",
    "turbo": "^2.9.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
}
