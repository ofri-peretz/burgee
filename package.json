{
  "name": "cli",
  "version": "0.0.0",
  "description": "Interlace CLI: agent-native extensions for commander and yargs (commander-*, yargs-*), their shared contract (@interlace/cli-core), and the documentation site.",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.6.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofri-peretz/cli.git"
  },
  "bugs": {
    "url": "https://github.com/ofri-peretz/cli/issues"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "[ -d .git ] && lefthook install || true",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --config vitest.root.config.ts && turbo run test",
    "lint": "eslint . --max-warnings 0 && npm run lint:workflows && npm run lint:md && turbo run lint",
    "ci:local": "lefthook run pre-push --all-files --force",
    "research:refresh": "scripts/fetch-competitor-issues.sh",
    "changeset": "changeset",
    "changeset:status": "env -u GIT_DIR changeset status --since=origin/main",
    "changeset:version": "changeset version && npm install --package-lock-only --ignore-scripts",
    "lint:workflows": "tsx scripts/lint-workflows.ts",
    "lint:md": "markdownlint-cli2 '**/*.md' '#node_modules' '#**/node_modules' '#**/dist' '#**/.next' '#docs/research/issues'",
    "release": "gh workflow run release.yml --ref main",
    "release:dry-run": "gh workflow run release.yml --ref main -f dry-run=true",
    "control-bands": "tsx scripts/control-bands.ts",
    "evals": "tsx scripts/run-evals.ts",
    "evals:config": "tsx scripts/run-evals.ts --config"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "eslint": "^9.39.4",
    "eslint-plugin-conventions": "^4.0.7",
    "eslint-plugin-import-next": "^2.7.5",
    "eslint-plugin-maintainability": "^3.0.3",
    "eslint-plugin-modernization": "^2.0.4",
    "eslint-plugin-modularity": "^2.0.4",
    "eslint-plugin-node-security": "^4.2.0",
    "eslint-plugin-operability": "^3.0.6",
    "eslint-plugin-react-a11y": "^2.1.5",
    "eslint-plugin-react-features": "^1.1.4",
    "eslint-plugin-reliability": "^4.1.3",
    "eslint-plugin-secure-coding": "^5.3.3",
    "js-yaml": "^4.1.0",
    "lefthook": "^1.7.0",
    "markdownlint-cli2": "^0.18.0",
    "prettier": "^3.4.0",
    "semver": "^7.7.0",
    "tsx": "^4.19.0",
    "turbo": "^2.9.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}
